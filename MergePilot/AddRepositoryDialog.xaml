<Window x:Class="MergePilot.AddRepositoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Repository"
        Height="300"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#0A192F"
        Foreground="#CBD5E1"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Repository Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Repository Name:" Foreground="#38BDF8" FontWeight="Bold"/>
            <TextBox x:Name="RepoNameTextBox"
                     Background="#1A3A52"
                     Foreground="#CBD5E1"
                     BorderBrush="#334155"
                     Padding="10"
                     Height="35"/>
        </StackPanel>

        <!-- Repository Path -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Label Content="Repository Path:" Foreground="#38BDF8" FontWeight="Bold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="RepoPathTextBox"
                         Background="#1A3A52"
                         Foreground="#CBD5E1"
                         BorderBrush="#334155"
                         Padding="10"
                         Height="35"/>
                <Button Grid.Column="1"
                        Content="🗂️ Browse"
                        Click="BrowseFolder_Click"
                        Background="#0874F7"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        Margin="10,0,0,0"
                        Height="35"
                        VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Remote URL -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <Label Content="Remote URL (Optional):" Foreground="#38BDF8" FontWeight="Bold"/>
            <TextBox x:Name="RemoteUrlTextBox"
                     Background="#1A3A52"
                     Foreground="#CBD5E1"
                     BorderBrush="#334155"
                     Padding="10"
                     Height="35"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="3"
                   x:Name="ErrorMessage"
                   Foreground="#EF4444"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save"
                    Click="Save_Click"
                    Background="#10B981"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Height="40"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Background="#64748B"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="20,10"
                    Height="40"/>
        </StackPanel>
    </Grid>
</Window>
