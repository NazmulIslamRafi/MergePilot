<Controls:MetroWindow x:Class="MergePilot.RepositoryManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Repository Manager"
        TitleAlignment="Center"
        Height="600"
        Width="700"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#0A192F"
        GlowBrush="#0874f7"
        ShowIconOnTitleBar="True"
        BorderThickness="1">

    <Grid Background="#0A192F">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <TabControl Grid.Row="0" 
                    Background="#0F2744"
                    Foreground="#0284C7">

            <!-- Repositories Tab -->
            <TabItem Header="📁 Repositories" Background="#1A3A52">
                <Grid Background="#0F2744">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="RepositoriesList"
                             Grid.Row="0"
                             Background="#1A3A52"
                             Foreground="#CBD5E1"
                             Margin="10"
                             VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#334155" BorderThickness="1" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Vertical" Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="#38BDF8" 
                                                       FontWeight="Bold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Path}" 
                                                       Foreground="#94A3B8" 
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" 
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <Button Content="✏️" 
                                                    Padding="5"
                                                    Click="EditRepo_Click"
                                                    Margin="0,0,5,0"
                                                    ToolTip="Edit Repository"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                            <Button Content="🗑️" 
                                                    Padding="5"
                                                    Click="DeleteRepo_Click"
                                                    ToolTip="Delete Repository"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Height="50">
                        <Button Content="➕ Add Repository"
                                Click="AddRepo_Click"
                                Padding="15,10"
                                Background="#0874F7"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,5,0"
                                FontSize="14"
                                FontWeight="Bold"
                                Height="40"
                                VerticalAlignment="Center"/>
                        <Button Content="🔄 Refresh Branches"
                                Click="RefreshBranches_Click"
                                Padding="15,10"
                                Background="#10B981"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                Height="40"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Branches Tab -->
            <TabItem Header="🌿 Custom Branches" Background="#1A3A52">
                <Grid Background="#0F2744">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="BranchesList"
                             Grid.Row="0"
                             Background="#1A3A52"
                             Foreground="#CBD5E1"
                             Margin="10"
                             VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#334155" BorderThickness="1" Padding="10" Margin="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Vertical" Grid.Column="0">
                                            <TextBlock Text="{Binding BranchName}" 
                                                       Foreground="#38BDF8" 
                                                       FontWeight="Bold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Repository}" 
                                                       Foreground="#94A3B8" 
                                                       FontSize="11"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" 
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <Button Content="✏️" 
                                                    Padding="5"
                                                    Click="EditBranch_Click"
                                                    Margin="0,0,5,0"
                                                    ToolTip="Edit Branch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                            <Button Content="🗑️" 
                                                    Padding="5"
                                                    Click="DeleteBranch_Click"
                                                    ToolTip="Delete Branch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Height="50">
                        <Button Content="➕ Add Branch"
                                Click="AddBranch_Click"
                                Padding="15,10"
                                Background="#0874F7"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                Height="40"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="10">
            <Button Content="Close"
                    Click="Close_Click"
                    Padding="20,10"
                    Background="#64748B"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
