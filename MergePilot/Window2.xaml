<Controls:MetroWindow x:Class="MergePilot.Window2"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      Title="Merge Pilot"
                      MinHeight="500"
                      MinWidth="600"
                      WindowStartupLocation="CenterScreen"
                      Background="#0A192F"
                      GlowBrush="#60A5FA"
                      BorderThickness="0"
                      WindowTransitionsEnabled="True">

    <Controls:MetroWindow.Resources>
        <Style TargetType="CheckBox" x:Key="ResponsiveCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="ResponsiveComboBoxStyle">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Width" Value="300"/>
        </Style>
        <LinearGradientBrush x:Key="NormalGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#3B82F6"/>
            <GradientStop Offset="1.0" Color="#60A5FA"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#2563EB"/>
            <GradientStop Offset="1.0" Color="#3B82F6"/>
        </LinearGradientBrush>
    </Controls:MetroWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="15" Padding="20" Background="#1E293B" Effect="{DynamicResource MaterialDesignElevation6}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="🚀 Merge Pilot"
                           Foreground="#60A5FA"
                           FontSize="32"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Margin="0 0 0 20"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>

                <!-- Target Repository -->
                <TextBlock Grid.Row="1" Text="Select Target Repository:"
                           Foreground="#CBD5E1"
                           FontSize="16"
                           FontWeight="Medium"
                           FontFamily="Segoe UI"
                           Margin="0 15 0 10"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 20">
                    <CheckBox x:Name="chkAuthBackend" Tag="D:\TechnoNext\OTA_Project\B2C\website-backend-auth"
                              Content="Auth Backend"
                              Style="{StaticResource ResponsiveCheckBoxStyle}"
                              Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkWebBackend" Tag="D:\TechnoNext\OTA_Project\B2C\website-backend-merge"
                              Content="Website Backend"
                              Style="{StaticResource ResponsiveCheckBoxStyle}"
                              Foreground="#CBD5E1"/>
                </StackPanel>

                <!-- Source Branch -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 0 0 20">
                    <TextBlock Text="Source Branch:"
                               Foreground="#CBD5E1"
                               FontSize="16"
                               FontWeight="Medium"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="0 0 15 0"/>
                    <ComboBox x:Name="SourceBranchBox"
                              Style="{StaticResource ResponsiveComboBoxStyle}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Development" FontSize="14"/>
                    </ComboBox>
                </StackPanel>

                <!-- Target Environments -->
                <TextBlock Grid.Row="4" Text="Select Target Environments:"
                           Foreground="#CBD5E1"
                           FontSize="16"
                           FontWeight="Medium"
                           FontFamily="Segoe UI"
                           Margin="0 15 0 10"/>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0 0 0 20">
                    <CheckBox x:Name="chkDev" Content="Dev" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkStage" Content="Stage" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkPreProd" Content="Pre-Prod" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkProd" Content="Prod" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1"/>
                </StackPanel>

                <!-- Client Branches -->
                <TextBlock Grid.Row="6" Text="Select Target Client Branch:"
                           Foreground="#CBD5E1"
                           FontSize="16"
                           FontWeight="Medium"
                           FontFamily="Segoe UI"
                           Margin="0 15 0 10"/>
                <WrapPanel Grid.Row="7" Margin="0 0 0 20" ItemHeight="30" ItemWidth="140">
                    <CheckBox x:Name="chkFirsttrip" Tag="b2c-first-trip" Content="First Trip" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1" Margin="0 0 15 0"/>
                    <CheckBox x:Name="chkTriplover" Tag="b2c-triplover" Content="Trip Lover" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1" Margin="0 0 15 0"/>
                    <CheckBox x:Name="chkTravelchamp" Tag="b2c-travelchamp" Content="TravelChamp" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1" Margin="0 0 15 0"/>
                    <CheckBox x:Name="chkTakeoff" Tag="b2c-takeoff" Content="TakeOff" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkTaketrip" Tag="b2c-taketrip" Content="TakeTrip" Style="{StaticResource ResponsiveCheckBoxStyle}" Foreground="#CBD5E1"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Merge Button -->
        <Button Grid.Row="1" Content="🚀 MERGE BRANCHES"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Background="{StaticResource NormalGradientBrush}"
                Foreground="White"
                FontWeight="Bold"
                Height="50"
                Padding="20 10"
                Margin="0 20 0 20"
                HorizontalAlignment="Center"
                Click="Merge_Click"
                materialDesign:ButtonProgressAssist.IsIndeterminate="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverGradientBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Output Log -->
        <TextBlock Grid.Row="2" Text="Output Log:"
                   Foreground="#CBD5E1"
                   FontSize="16"
                   FontWeight="Medium"
                   FontFamily="Segoe UI"
                   Margin="0 20 0 10"/>
        <ScrollViewer Grid.Row="3" Height="200" Background="#111827" Padding="10" VerticalScrollBarVisibility="Auto">
            <Border CornerRadius="10" Background="#1F2937">
                <TextBlock x:Name="OutputBox"
                           Foreground="#E2E8F0"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Padding="10"/>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <TextBlock Grid.Row="4" Text="Developed by Md Nazmul Islam"
                   Foreground="#64748B"
                   FontSize="14"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Right"
                   Margin="0 20 0 20"/>
    </Grid>
</Controls:MetroWindow>