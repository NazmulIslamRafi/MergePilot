<Controls:MetroWindow x:Class="MergePilot.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
xmlns:Ease="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore"
xmlns:local="clr-namespace:MergePilot"
xmlns:vm="clr-namespace:MergePilot.ViewModels"
Title="Merge Pilot"
                      TitleAlignment="Center"
                      TitleCharacterCasing="Normal"
                      MinWidth="700"
                      MinHeight="720"
                      WindowStartupLocation="CenterScreen"
                      Background="#0A192F"
                      GlowBrush="#0874f7"
                      BorderThickness="1"
                      WindowTransitionsEnabled="True"
                      Closing="MetroWindow_Closing">

    <!-- Initialize DataContext with MainWindowViewModel -->
    <Controls:MetroWindow.DataContext>
        <vm:MainWindowViewModel />
    </Controls:MetroWindow.DataContext>

    <Controls:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <materialDesign:PackIcon Kind="TableMergeCells"
                                     Width="15"
                                     Height="15"
                                     Margin="5 5"
                                     Foreground="#38BDF8"/>

                <TextBlock Text="{Binding}"
                       FontFamily="Alkatra SemiBold"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Controls:MetroWindow.TitleTemplate>

    <Controls:MetroWindow.Resources>

        <local:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />

        <!-- Color Scheme from Bash Script -->
        <Color x:Key="SuccessGreenColor">#22C55E</Color>
        <Color x:Key="WarningYellowColor">#EAB308</Color>
        <Color x:Key="ErrorRedColor">#EF4444</Color>
        <Color x:Key="InfoBlueColor">#3B82F6</Color>
        <Color x:Key="SecondaryBlueColor">#60A5FA</Color>

        <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}"/>
        <SolidColorBrush x:Key="WarningYellowBrush" Color="{StaticResource WarningYellowColor}"/>
        <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}"/>
        <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}"/>
        <SolidColorBrush x:Key="SecondaryBlueBrush" Color="{StaticResource SecondaryBlueColor}"/>

        <Style TargetType="CheckBox" x:Key="ResponsiveCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBox Style for Branch Selection (dark-themed, full-area click) -->
        <Style TargetType="ComboBox" x:Key="ResponsiveComboBoxStyle">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#142033"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- Dark-themed ComboBoxItem container -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1A3A52"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1E3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <!-- Full-area invisible toggle — clicking anywhere opens the dropdown -->
                                    <ToggleButton x:Name="DropToggle"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- Placeholder shown when nothing selected -->
                                    <TextBlock x:Name="Placeholder"
                                               Text="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="#475569"
                                               FontStyle="Italic"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Margin="10,0,30,0"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <!-- Selected item text (non-interactive overlay) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,30,0"
                                                      IsHitTestVisible="False"/>
                                    <!-- Arrow icon (non-interactive overlay) -->
                                    <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="#64748B"
                                          Stretch="Uniform"
                                          Width="10" Height="6"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide"
                                   Width="{Binding ActualWidth, ElementName=Root}">
                                <Border Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  SnapsToDevicePixels="True"
                                                  Margin="2">
                                        <VirtualizingStackPanel IsItemsHost="True"
                                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Show placeholder when no item is selected -->
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#0F1A2B"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multi-Select CheckBox Style -->
        <Style TargetType="CheckBox" x:Key="MultiSelectCheckBoxStyle">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Dynamic Repository CheckBox Style -->
        <Style TargetType="CheckBox" x:Key="DynamicRepoCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Data Template for Hierarchical Branch Items -->
        <DataTemplate x:Key="HierarchicalBranchTemplate">
            <StackPanel Orientation="Horizontal" Margin="0">
                <!-- Indentation based on level -->
                <StackPanel Width="{Binding Level, Converter={StaticResource LevelToIndentConverter}}" />
                
                <!-- Checkbox for both groups and leaves -->
                <CheckBox x:Name="BranchCheckBox"
                          Margin="4,0,8,0"
                          Style="{StaticResource MultiSelectCheckBoxStyle}"
                          Tag="{Binding FullName}"
                          AutomationProperties.Name="{Binding FullName}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Checked="BranchCheckBox_Changed"
                          Unchecked="BranchCheckBox_Changed"
                          IsThreeState="{Binding IsGroup}"/>
                
                <!-- Display text -->
                <TextBlock Text="{Binding Name}"
                           Foreground="#E2E8F0"
                           FontWeight="{Binding IsGroup, Converter={StaticResource BoolToFontWeightConverter}}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Data Template for ComboBox Items with Checkboxes -->
        <DataTemplate x:Key="MultiSelectItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="4">
                <CheckBox x:Name="SelectCheckBox" 
                          Margin="0,0,8,0"
                          Style="{StaticResource MultiSelectCheckBoxStyle}"
                          Tag="{Binding}"
                          Checked="BranchCheckBox_Changed"
                          Unchecked="BranchCheckBox_Changed"/>
                <TextBlock Text="{Binding}"
                           Foreground="#E2E8F0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <LinearGradientBrush x:Key="NormalGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0369A1" Offset="1"/>
        </LinearGradientBrush>

    </Controls:MetroWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- Converters and responsive resources -->
        <ScrollViewer.Resources>
            <local:WidthToBoolConverter x:Key="WidthToBoolConverter" Threshold="900" />
        </ScrollViewer.Resources>
        <StackPanel Margin="5">
            <!-- ============================================
             PORTION 1: REPOSITORY & BRANCH SELECTION
             ============================================ -->
            <Border CornerRadius="15" Padding="5" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Margin="0 0 0 5">
                <StackPanel>
                    <!-- Section Header -->
                    <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5">
                        -->
                    <!-- Merge Icon -->
                    <!--
                        <materialDesign:PackIcon Kind="SourceMerge" 
                             Width="20" 
                             Height="20" 
                             Foreground="#60A5FA"
                             VerticalAlignment="Center"/>

                        -->
                    <!-- Title -->
                    <!--
                        <TextBlock x:Name="TitleText" Text="Merge Pilot"
                                   Foreground="#60A5FA"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FontFamily="Alkatra SemiBold"
                                   VerticalAlignment="Center"
                                   TextDecorations="Underline"
                                   ToolTip="Merge Pilot - smart branch merging"
                                   AutomationProperties.Name="AppTitle"
                                   Margin="2 0 0 0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="30" />
                                    <Setter Property="FontFamily" Value="Alkatra SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Controls:MetroWindow}, Converter={StaticResource WidthToBoolConverter}}" Value="True">
                                            <Setter Property="FontSize" Value="22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>-->

                    <!-- Separator Line -->
                    <!--<Border Height="1" Background="#1E293B" Margin="0,2,0,2"/>-->

                    <StackPanel>
                        <StackPanel Margin="0 0 0 2">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="📁 Target Repository"
                                       Grid.Column="1"
                                       Foreground="#CBD5E1"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       FontFamily="Alkatra SemiBold"
                                       Margin="0,0,1000,5" Grid.ColumnSpan="2"/>
                                
                                <Button Grid.Column="2"
                                        Content="Add Repo" 
                                        Command="{Binding ManageRepositoriesWorkflowCommand}"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{StaticResource NormalGradientBrush}"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        FontSize="12"
                                        FontFamily="Alkatra SemiBold"
                                        Width="100"
                                        Height="25"
                                        Padding="2 2"                                        
                                        ToolTip="Open repository manager (Ctrl+B)" 
                                        AutomationProperties.Name="ManageRepositoriesButton">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon x:Name="AddIcon" Kind="AttachmentAdd" Width="20" Height="20"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>

                                </Button>
                            </Grid>
                            
                            
                            <StackPanel Margin="0 0 0 2">
                                <StackPanel Margin="0">
                                    <!-- Repository management panel (collapsed by default) -->
                                    <StackPanel x:Name="RepoManagePanel" Orientation="Vertical" Visibility="Collapsed" Margin="0 2 0 0" Background="{StaticResource NormalGradientBrush}">
                                        <Grid Margin="2 2 2 2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" MinWidth="180" Height="26" Margin="0 0 8 0" Text="{Binding InlineRepositoryName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Repo friendly name" ToolTip="Friendly name for the repo" AutomationProperties.Name="RepoName" />
                                            <TextBox Grid.Column="1" Height="26" Margin="0 0 8 0" HorizontalAlignment="Stretch" Text="{Binding InlineRepositoryPath, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Local path to repository" ToolTip="Local filesystem path to the repository" AutomationProperties.Name="RepoPath" />
                                            <Button Grid.Column="2" Content="..." Width="28" Height="26" Margin="0 0 8 0" Command="{Binding BrowseRepositoryPathWorkflowCommand}" />
                                            <Button Grid.Column="3" Content="Add Repo" Width="90" Height="26" Command="{Binding AddRepositoryWorkflowCommand}" IsEnabled="{Binding CanAddInlineRepository}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="12 4 12 0">
                                            <ListView x:Name="lstRepos" MinWidth="200" Height="120" HorizontalAlignment="Stretch" SelectionChanged="LstRepos_SelectionChanged"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ItemsSource="{Binding Repositories}"
                                          ToolTip="List of configured repositories" AutomationProperties.Name="RepositoriesList" KeyboardNavigation.TabIndex="5">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                                                        <GridViewColumn Header="Path" Width="480" DisplayMemberBinding="{Binding Path}" />
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="12 8 12 12">
                                            <Button x:Name="btnEditRepo" Content="Edit Selected" Width="100" Height="26" Command="{Binding EditRepositoryWorkflowCommand}" Margin="0 0 8 0" ToolTip="Edit selected repo" AutomationProperties.Name="EditRepoButton" />
                                            <Button Content="Update" Width="80" Height="26" Command="{Binding UpdateRepositoryWorkflowCommand}" IsEnabled="{Binding CanUpdateInlineRepository}" Margin="0 0 8 0" ToolTip="Update selected repo" AutomationProperties.Name="UpdateRepoButton" />
                                            <Button x:Name="btnRemoveRepo" Content="Remove Selected" Width="120" Height="26" Command="{Binding RemoveRepositoryWorkflowCommand}" ToolTip="Remove selected repo" AutomationProperties.Name="RemoveRepoButton" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0,2,0,2"/>
                    
                    <!-- Target Repository Section -->
                    <StackPanel Margin="0 0 0 2">
                        <StackPanel Margin="0">
                            <!-- Dynamic repository checkboxes -->
                            <ItemsControl x:Name="DynamicRepoPanel"
                                          ItemsSource="{Binding SelectableRepositories}"
                                          Margin="0 0 0 2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  Tag="{Binding Path}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  Style="{StaticResource DynamicRepoCheckBoxStyle}"
                                                  Margin="0 0 15 0"
                                                  Checked="CheckBox_Changed"
                                                  Unchecked="CheckBox_Changed"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0,2,0,2"/>

                </StackPanel>
            </Border>

            <!-- ============================================
             PORTION 2: ACTION BUTTONS
             ============================================ -->
            <Border CornerRadius="15" Padding="10" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Margin="0 0 0 5">
                <StackPanel>
                    <!-- Branches Section -->
                    <StackPanel Margin="0">
                        <TextBlock Text="🌿 Branch Configuration And Actions"
                               Foreground="#CBD5E1"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Alkatra SemiBold"
                               Margin="0 0 0 2"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" Text="Source Branch :"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontFamily="Alkatra SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0 0 2 0"/>
                            <ComboBox Grid.Column="3" x:Name="SourceBranchBox"
                                  Style="{StaticResource ResponsiveComboBoxStyle}"
                                  MinWidth="150"
                                  HorizontalAlignment="Stretch"
                                  StaysOpenOnEdit="True"
                                  IsEditable="False"
                                  ScrollViewer.CanContentScroll="True"
                                  AutomationProperties.AutomationId="SourceBranchBox"
                                  AutomationProperties.Name="Source Branches"
                                  ItemsSource="{Binding SourceBranches}"
                                  materialDesign:HintAssist.Hint="Select source branches (check items)"
                                  ItemTemplate="{StaticResource HierarchicalBranchTemplate}" />

                            <TextBlock Grid.Column="5" Text="Target Branch :"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontFamily="Alkatra SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0 0 2 0"/>
                            <ComboBox Grid.Column="7" x:Name="TargetBranchBox"
                                  Style="{StaticResource ResponsiveComboBoxStyle}"
                                  MinWidth="150"
                                  HorizontalAlignment="Stretch"
                                  StaysOpenOnEdit="True"
                                  IsEditable="False"
                                  AutomationProperties.AutomationId="TargetBranchBox"
                                  AutomationProperties.Name="Target Branches"
                                  ItemsSource="{Binding TargetBranches}"
                                  materialDesign:HintAssist.Hint="Select target branches (check items)"
                                  ItemTemplate="{StaticResource HierarchicalBranchTemplate}" />

                            <!-- ⚡ Title -->
                            <TextBlock Grid.Column="9"
                                  Text="⚡ Actions"
                                  Foreground="#CBD5E1"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  FontFamily="Alkatra SemiBold"
                                  VerticalAlignment="Center">
                            </TextBlock>

                            <!-- Merge Button -->
                            <Button x:Name="btnMerge"
                                    Grid.Column="11"
                                    Command="{Binding MergeWorkflowCommand}"
                                    AutomationProperties.AutomationId="MergeButton"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Height="36"
                                    Padding="14,0"
                                    Cursor="Hand"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="BtnBg" Color="#1E3A5F"/>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0">
                                                <materialDesign:PackIcon Kind="SourceMerge" Width="18" Height="18"
                                                                         Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Merge" Foreground="White" FontWeight="SemiBold"
                                                           FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#264D7A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#162E4A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#1A2744"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Pull Button -->
                            <Button x:Name="btnPullBranches"
                                    Grid.Column="13"
                                    Command="{Binding PullWorkflowCommand}"
                                    AutomationProperties.AutomationId="PullButton"
                                    ToolTip="Fetch latest branches from origin for selected repositories"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Height="36"
                                    Padding="14,0"
                                    Cursor="Hand"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#1E3A5F"/>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0">
                                                <materialDesign:PackIcon Kind="SourcePull" Width="18" Height="18"
                                                                         Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Pull" Foreground="White" FontWeight="SemiBold"
                                                           FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#264D7A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#162E4A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Background" Value="#1A2744"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Refresh Button -->
                            <Button x:Name="btnRefreshBranches"
                                    Grid.Column="15"
                                    Command="{Binding RefreshWorkflowCommand}"
                                    AutomationProperties.AutomationId="RefreshButton"
                                    ToolTip="Refresh remote branch list for selected repositories"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Height="36"
                                    Padding="14,0"
                                    Cursor="Hand"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#38BDF8" Offset="0"/>
                                                    <GradientStop Color="#0284C7" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0284C7" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0">
                                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Refresh" Foreground="White" FontWeight="SemiBold"
                                                           FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>


                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================
             PORTION 3: LOG PANEL
             ============================================ -->
            <Border CornerRadius="15" Padding="5" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Margin="0 0 0 5">
                <StackPanel>
                    <TextBlock Text="📜 Log Output"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Alkatra SemiBold"
                           Margin="0 0 0 2"/>

                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0 0 0 2"/>

                    <!-- Single Log Display -->
                    <Border Background="#0F1724" CornerRadius="6" Padding="5" Height="430" RenderOptions.CachingHint="Cache">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
                            <RichTextBox x:Name="OutputBox" AutomationProperties.AutomationId="OutputLogBox" AutomationProperties.Name="Log Output" IsReadOnly="True" FontFamily="Alkatra" FontSize="11" Background="#0F1724" Foreground="#E2E8F0" BorderThickness="0" Margin="0" Padding="5" TextOptions.TextRenderingMode="Auto" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================
             FOOTER
             ============================================ -->
            <TextBlock Text="Developed by Md Nazmul Islam"
                   Foreground="#64748B"
                   FontSize="10"
                   FontFamily="Alkatra SemiBold"
                   HorizontalAlignment="Right"
                   Margin="0 2 0 2"/>
        </StackPanel>
    </ScrollViewer>
</Controls:MetroWindow>
