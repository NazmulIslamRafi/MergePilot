<Window x:Class="MergePilot.AddBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Branch"
        Height="230"
        Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#0A192F"
        Foreground="#CBD5E1"
        ResizeMode="NoResize">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Repository Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <Label Content="Repository:" Foreground="#38BDF8" FontWeight="Bold"/>
            <ComboBox x:Name="RepositoryComboBox"
                      Background="#1A3A52"
                      Foreground="#CBD5E1"
                      BorderBrush="#334155"
                     Padding="5"
                     Height="20"/>
        </StackPanel>

        <!-- Branch Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,5">
            <Label Content="Branch Name:" Foreground="#38BDF8" FontWeight="Bold"/>
            <TextBox x:Name="BranchNameTextBox"
                     Background="#1A3A52"
                     Foreground="#CBD5E1"
                     BorderBrush="#334155"
                     Padding="5"
                     Height="20"
                     ToolTip="e.g., feature/new-feature or 0-Task/NewTask"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock x:Name="ErrorMessage"
                   Grid.Row="2"
                   Foreground="#EF4444"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   MinHeight="20"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
            <Button Content="Save"
                    Click="Save_Click"
                    Background="#10B981"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="5,5,5,5"
                    Margin="0,0,10,0"
                    Height="15"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Background="#64748B"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="5,5,5,5"
                    Margin="0,0,10,0"
                    Height="15"/>
        </StackPanel>
    </Grid>
</Window>
