<Window x:Class="MergePilot.AddBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add/Edit Branch"
        Height="320"
        Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#0A192F"
        Foreground="#CBD5E1"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Button style for dialog actions -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#334155"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style for dialog -->
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#142033"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <!-- Full-area invisible toggle — clicking anywhere opens the dropdown -->
                                    <ToggleButton x:Name="DropToggle"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- Selected item text (non-interactive overlay) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,32,0"
                                                      IsHitTestVisible="False"/>
                                    <!-- Arrow icon (non-interactive overlay) -->
                                    <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="#64748B"
                                          Stretch="Uniform"
                                          Width="10" Height="6"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide"
                                   Width="{Binding ActualWidth, ElementName=Root}">
                                <Border Background="#1E293B"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="200" Margin="2">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#0F1A2B"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox style for dialog -->
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#142033"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Background" Value="#1A3A52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="1" CornerRadius="2">
        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Repository label -->
            <TextBlock Grid.Row="0"
                       Text="Repository"
                       Foreground="#38BDF8"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,0,5"/>

            <!-- Repository ComboBox -->
            <ComboBox Grid.Row="0"
                      x:Name="RepositoryComboBox"
                      Style="{StaticResource DialogComboBoxStyle}"
                      Margin="80,0,0,0"/>

            <!-- Branch label row with "Type manually" toggle -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Branch"
                           Foreground="#38BDF8"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="2"
                          x:Name="ManualEntryCheckBox"
                          Content="Type manually"
                          Foreground="#94A3B8"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Checked="ManualEntryCheckBox_Changed"
                          Unchecked="ManualEntryCheckBox_Changed"/>
            </Grid>

            <!-- Branch input area -->
            <Grid Grid.Row="4">
                <!-- Remote dropdown mode (default) -->
                <ComboBox x:Name="BranchComboBox"
                          Style="{StaticResource DialogComboBoxStyle}"
                          IsEnabled="False"/>
                <!-- No-repo placeholder -->
                <TextBlock x:Name="NoRepoText"
                           Text="Select a repository above to load branches"
                           Foreground="#475569"
                           FontSize="12"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
                <!-- Manual text entry mode (hidden by default) -->
                <TextBox x:Name="ManualBranchTextBox"
                         Style="{StaticResource DialogTextBoxStyle}"
                         Visibility="Collapsed"
                         ToolTip="Enter branch name, e.g. feature/my-branch"/>
            </Grid>

            <!-- Loading indicator -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0">
                <materialDesign:PackIcon x:Name="LoadingIcon"
                                         Kind="Loading"
                                         Width="13" Height="13"
                                         Foreground="#38BDF8"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         Visibility="Collapsed"/>
                <TextBlock x:Name="LoadingText"
                           Text="Loading branches from remote..."
                           Foreground="#64748B"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Push to remote (only in manual mode) -->
            <CheckBox Grid.Row="6"
                      x:Name="PushToRemoteCheckBox"
                      Content="Push this branch to remote after saving"
                      Foreground="#60A5FA"
                      FontSize="12"
                      Margin="0,6,0,0"
                      Visibility="Collapsed"/>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorMessage"
                       Grid.Row="7"
                       Foreground="#EF4444"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,8,0,0"
                       VerticalAlignment="Top"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="SAVE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DialogButtonStyle}"
                        Background="#334155"
                        Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="CANCEL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
