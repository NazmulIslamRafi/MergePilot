<Window x:Class="MergePilot.SplashScreen"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Pilot"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="600" Height="350"
        Background="#0F172A"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Logo and Title -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Canvas Width="80" Height="80" Margin="0,0,0,10">
                <!-- Simple merge arrow icon -->
                <Path Data="M20,60 L40,40 L60,60 M40,40 L40,20" 
                      Stroke="#38BDF8" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
            </Canvas>

            <TextBlock Text="Merge Pilot" 
                       Foreground="#FFFFFF" 
                       FontSize="28" 
                       FontFamily="Alkatra SemiBold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Automate · Merge · Deploy"
                       Foreground="#94A3B8"
                       FontSize="16"
                       FontFamily="Alkatra SemiBold"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,15,10">
            <TextBlock Text="Developed by Md Nazmul Islam"
                       Foreground="#64748B"
                       FontFamily="Alkatra SemiBold"
                       FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
