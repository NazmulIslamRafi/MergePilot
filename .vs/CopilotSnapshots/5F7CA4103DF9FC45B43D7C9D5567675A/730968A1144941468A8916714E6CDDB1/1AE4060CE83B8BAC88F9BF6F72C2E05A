<Controls:MetroWindow x:Class="MergePilot.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      xmlns:Ease="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore"
                      xmlns:local="clr-namespace:MergePilot"
                      Title="Merge Pilot"
                      MinWidth="800"
                      MinHeight="600"
                      WindowStartupLocation="CenterScreen"
                      Background="#0A192F"
                      GlowBrush="#60A5FA"
                      BorderThickness="0"
                      WindowTransitionsEnabled="True"
                      Closing="MetroWindow_Closing">

    <Controls:MetroWindow.Resources>

        <Style TargetType="CheckBox" x:Key="ResponsiveCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
        </Style>
        <LinearGradientBrush x:Key="NormalGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0369A1" Offset="1"/>
        </LinearGradientBrush>

    </Controls:MetroWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <!-- Converters and responsive resources -->
    <ScrollViewer.Resources>
        <local:WidthToBoolConverter x:Key="WidthToBoolConverter" Threshold="900" />
    </ScrollViewer.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="15" Padding="22" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Height="233" Margin="0,0,0,71" Grid.RowSpan="2" VerticalAlignment="Bottom">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <!--<TextBlock Grid.Row="0" Text="🚀 Merge Pilot"
                           Foreground="#60A5FA"
                           FontSize="30"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>-->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,12">
                    <!-- Merge Icon -->
                    <materialDesign:PackIcon Kind="SourceMerge" 
                             Width="30" 
                             Height="30" 
                             Foreground="#60A5FA"
                             VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock x:Name="TitleText" Text="Merge Pilot"
               Foreground="#60A5FA"
               FontSize="30"
               FontWeight="Bold"
               FontFamily="Segoe UI"
               VerticalAlignment="Center"
               TextDecorations="Underline"
               ToolTip="Merge Pilot - smart branch merging"
               AutomationProperties.Name="AppTitle">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="30" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Controls:MetroWindow}, Converter={StaticResource WidthToBoolConverter}}" Value="True">
                                        <Setter Property="FontSize" Value="22" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Target Repository -->
                <TextBlock Grid.Row="1" Text="Select Target Repository :"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Margin="0 8 0 6"/>
                <StackPanel x:Name="RepoStackPanel" Grid.Row="2" Orientation="Vertical" Margin="0 0 0 12">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8" HorizontalAlignment="Right">
                        <Button Content="Manage Repositories" Click="ManageRepos_Click" Style="{StaticResource MaterialDesignRaisedButton}" Height="28"
                                ToolTip="Open repository manager (Ctrl+B)" AutomationProperties.Name="ManageRepositoriesButton" />
                    </StackPanel>

                    <!-- Dynamic repository checkboxes will be added here at runtime -->
                    <StackPanel x:Name="DynamicRepoPanel" Orientation="Vertical" />

                    <!-- Repository management panel (collapsed by default) -->
                    <StackPanel x:Name="RepoManagePanel" Orientation="Vertical" Visibility="Collapsed" Margin="0 8 0 0">
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtRepoName" Grid.Column="0" MinWidth="180" Height="26" Margin="0 0 8 0" materialDesign:HintAssist.Hint="Repo friendly name" ToolTip="Friendly name for the repo" AutomationProperties.Name="RepoName" />
                            <TextBox x:Name="txtRepoPath" Grid.Column="1" Height="26" Margin="0 0 8 0" HorizontalAlignment="Stretch" materialDesign:HintAssist.Hint="Local path to repository" ToolTip="Local filesystem path to the repository" AutomationProperties.Name="RepoPath" />
                            <Button x:Name="btnBrowseRepoPath" Grid.Column="2" Content="..." Width="28" Height="26" Margin="0 0 8 0" Click="BrowseRepoPath_Click" />
                            <Button x:Name="btnAddRepo" Grid.Column="3" Content="Add Repo" Width="90" Height="26" Click="AddRepo_Click" />
                        </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <ListView x:Name="lstRepos" MinWidth="200" Height="120" HorizontalAlignment="Stretch" SelectionChanged="LstRepos_SelectionChanged"
                                      ToolTip="List of configured repositories" AutomationProperties.Name="RepositoriesList" KeyboardNavigation.TabIndex="5">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Path" Width="480" DisplayMemberBinding="{Binding Path}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 6 0 0">
                            <Button x:Name="btnEditRepo" Content="Edit Selected" Width="100" Height="26" Click="EditRepo_Click" Margin="0 0 8 0" ToolTip="Edit selected repo" AutomationProperties.Name="EditRepoButton" />
                            <Button x:Name="btnUpdateRepo" Content="Update" Width="80" Height="26" Click="UpdateRepo_Click" IsEnabled="False" Margin="0 0 8 0" ToolTip="Update selected repo" AutomationProperties.Name="UpdateRepoButton" />
                            <Button x:Name="btnRemoveRepo" Content="Remove Selected" Width="120" Height="26" Click="RemoveRepo_Click" ToolTip="Remove selected repo" AutomationProperties.Name="RemoveRepoButton" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                


                <!-- Source Branch -->
                <Grid Grid.Row="3" Margin="0 6 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Source Branch :"
                               Foreground="#CBD5E1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="0 0 12 0"/>
                    <ComboBox Grid.Column="1" x:Name="SourceBranchBox"
                              Style="{StaticResource ResponsiveComboBoxStyle}"
                              MinWidth="150"
                              IsEditable="True"
                              HorizontalAlignment="Stretch"
                              materialDesign:HintAssist.Hint="Source branch (or type)" />

                    <TextBlock Grid.Column="3" Text="Target Branch :"
                               Foreground="#CBD5E1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="0 0 12 0"/>
                    <ComboBox Grid.Column="4" x:Name="TargetBranchBox"
                              Style="{StaticResource ResponsiveComboBoxStyle}"
                              MinWidth="150"
                              IsEditable="True"
                              HorizontalAlignment="Stretch"
                              materialDesign:HintAssist.Hint="Target branch (or type)" />
                </Grid>

                <!-- Target Environments and Client Branch selection removed (managed via explicit Target Branch) -->
            </Grid>
        </Border>

        <!-- Buttons -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0" ItemHeight="56" ItemWidth="Auto">
            <Button x:Name="btnMerge"
        Grid.Row="1"
                    Content="MERGE BRANCHES"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource NormalGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    Height="50"
                    Padding="20 10"
                    Margin="0,0,8,0"
                    Click="Merge_Click"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="RocketIcon" Kind="RocketLaunch" Foreground="#FB923C" Width="20" Height="20" Margin="0 0 8 0">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverGradientBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NormalGradientBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="RocketAnimStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation
                                                Storyboard.TargetName="RocketIcon"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="0" To="-6"
                                                Duration="0:0:0.6"
                                                AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Trigger.EnterActions>
                                    <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnPullBranches"
                    Content="PULL BRANCHES"
                    ToolTip="Fetch latest branches from origin for selected repositories"
                    Click="PullSelectedBranches_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource NormalGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    Height="50"
                    Padding="20 10"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False" />

                <Button x:Name="btnRefreshBranches"
                    Content="REFRESH BRANCHES"
                    ToolTip="Refresh remote branch list for selected repositories"
                    Click="RefreshBranches_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource NormalGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    Height="50"
                    Padding="20 10"
                    Margin="8 0 0 0"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False" />
        </WrapPanel>

        <!-- Output Log -->
        <DockPanel Grid.Row="2" LastChildFill="True">
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0 0 0 6" VerticalAlignment="Center" ItemHeight="32">
                    <Button Content="Show Logs" Width="100" Height="28" Margin="0 0 8 0" Click="ToggleLogs_Click" ToolTip="Show or hide inline logs (Ctrl+L)"/>

                    <Button x:Name="btnSaveLogs" Content="Save" Width="70" Height="28" Margin="0 0 8 0" Click="SaveLogs_Click" ToolTip="Save logs to file" />
                    <Button x:Name="btnClearLogs" Content="Clear" Width="70" Height="28" Margin="0 0 8 0" Click="ClearErrorBox_Click" ToolTip="Clear both output and error logs" />
                    <Button x:Name="btnCopyLogs" Content="Copy" Width="70" Height="28" Margin="0 0 8 0" Click="CopyLogs_Click" ToolTip="Copy combined logs to clipboard" />

                    <CheckBox x:Name="chkAutoOpen" Content="Auto-open logs" VerticalAlignment="Center" Margin="0 0 12 0" Checked="chkAutoOpen_Checked" Unchecked="chkAutoOpen_Unchecked"/>

                    <CheckBox x:Name="chkStreamLogs" Content="Stream Logs" VerticalAlignment="Center" Margin="0 0 6 0" Checked="chkStreamLogs_Checked" Unchecked="chkStreamLogs_Unchecked"/>
                    <TextBox x:Name="txtLogPath" Width="220" Height="26" IsReadOnly="True" Margin="0 0 6 0" VerticalAlignment="Center"/>
                    <Button Content="…" Width="28" Height="26" Click="SelectLogPath_Click" />

                    <!-- Streaming indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 12 0">
                        <Ellipse x:Name="ellipseStreamIndicator" Width="12" Height="12" Fill="#475569" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" ToolTip="Streaming disabled" />
                    </StackPanel>

                    <!-- Flush interval slider -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 0">
                        <TextBlock Text="Flush (ms):" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <Slider x:Name="sldFlushInterval" Minimum="100" Maximum="1000" Width="140" ValueChanged="sldFlushInterval_ValueChanged"/>
                        <TextBlock x:Name="txtFlushValue" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6 0 0 0"/>
                    </StackPanel>
                </WrapPanel>
        </DockPanel>
        <!--<TextBlock Grid.Row="2" Text="Output Log:"
                   Foreground="#CBD5E1"
                   FontSize="16"
                   FontWeight="Medium"
                   FontFamily="Segoe UI"
                   Margin="0 10 0 10"/>
        <ScrollViewer Grid.Row="3" Height="200" Background="#111827" Padding="10" VerticalScrollBarVisibility="Auto">
            <Border CornerRadius="10" Background="#1F2937">
                <TextBlock x:Name="OutputBox"
                           Foreground="#E2E8F0"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Padding="10"/>
            </Border>
        </ScrollViewer>-->
        <Border x:Name="LogBorder" Grid.Row="2" CornerRadius="15" Padding="10" Background="#0F1724" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Output Log" Foreground="#CBD5E1" FontSize="14" Margin="0 0 0 6"/>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="txtSearchOutput" Width="200" Height="24" Margin="0 0 8 6" materialDesign:HintAssist.Hint="Search output" />
                            <Button Content="Find" Width="60" Height="24" Click="FindOutput_Click" />
                            <CheckBox x:Name="chkShowOnlyOutputErrors" Content="Errors only" Margin="8 0 0 6" Checked="ChkFilterChanged" Unchecked="ChkFilterChanged" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="160" Background="#071422" Padding="6">
                            <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="#071422" Foreground="#E2E8F0" BorderThickness="0" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="12" Fill="Transparent" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Error Log" Foreground="#F87171" FontSize="14" Margin="0 0 0 6"/>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="txtSearchError" Width="200" Height="24" Margin="0 0 8 6" materialDesign:HintAssist.Hint="Search errors" />
                            <Button Content="Find" Width="60" Height="24" Click="FindError_Click" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="160" Background="#071422" Padding="6">
                            <TextBox x:Name="ErrorBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Background="#071422" Foreground="#FCA5A5" BorderThickness="0" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="Developed by Md Nazmul Islam"
                   Foreground="#64748B"
                   FontSize="14"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Right"
                   Margin="0 20 0 20"/>
    </Grid>
    </ScrollViewer>
</Controls:MetroWindow>