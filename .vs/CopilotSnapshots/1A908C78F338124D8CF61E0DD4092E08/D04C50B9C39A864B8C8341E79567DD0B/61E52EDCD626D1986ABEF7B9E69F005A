        private List<string> GetSelectedRepositories()
        {
            var selectedRepos = new List<string>();

            try
            {
                foreach (var child in DynamicRepoPanel.Children)
                {
                    if (child is CheckBox cb && cb.IsChecked == true && cb.Tag is string path && !string.IsNullOrWhiteSpace(path))
                        selectedRepos.Add(path);
                }
            }
            catch { }

            return selectedRepos;
        }

        private bool PanelHasCheckedCheckBox(System.Windows.Controls.Panel panel)
        {
            foreach (var child in panel.Children)
            {
                if (child is CheckBox cb && cb.IsChecked == true)
                    return true;

                if (child is System.Windows.Controls.Panel innerPanel && PanelHasCheckedCheckBox(innerPanel))
                    return true;

                // cover ContentControls that may host a CheckBox (e.g. WrapPanel items)
                if (child is System.Windows.Controls.ContentControl contentControl && contentControl.Content is CheckBox contentCb && contentCb.IsChecked == true)
                    return true;
            }
            return false;
        }

        private void ValidateSelections()
        {
            bool hasRepo = PanelHasCheckedCheckBox(RepoStackPanel);
            // Since env and client selection were removed, require a repo and an explicit target branch
            bool hasEnv = true;
            bool hasClient = true;
            bool hasTarget = !string.IsNullOrWhiteSpace(TargetBranchBox?.Text);

            // additionally, pre-validate target branch exists on remotes of selected repos
            bool allHaveTarget = true;
            try
            {
                var target = TargetBranchBox?.Text?.Trim();
                if (hasRepo && hasTarget && !string.IsNullOrWhiteSpace(target))
                {
                    var selected = GetSelectedRepositories();
                    var checks = selected.Select(async repo => await GitHelper.RemoteBranchExistsAsync(repo, await GitHelper.GetDefaultRemoteNameAsync(repo).ConfigureAwait(false), target).ConfigureAwait(false));
                    Task.WaitAll(checks.ToArray());
                    foreach (var t in checks)
                    {
                        if (!t.Result)
                        {
                            allHaveTarget = false;
                            break;
                        }
                    }
                }
            }
            catch { allHaveTarget = false; }

            bool enabled = hasRepo && hasTarget && allHaveTarget;
            btnMerge.IsEnabled = enabled;
            // Keep pull branches button following same selection rules
            if (btnPullBranches != null)
                btnPullBranches.IsEnabled = enabled;

            // Auto-fill target branch template if target combobox is empty and single client+env selected
            // no auto-fill behavior now; user must enter or pick a target branch
        }

