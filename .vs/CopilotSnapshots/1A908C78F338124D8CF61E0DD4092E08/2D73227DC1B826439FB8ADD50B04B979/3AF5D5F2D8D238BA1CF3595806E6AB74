            this.InputBindings.Add(new System.Windows.Input.KeyBinding(new RelayCommand(_ => OpenLogWindow_Click(null, null)), System.Windows.Input.Key.O, System.Windows.Input.ModifierKeys.Control));
            this.InputBindings.Add(new System.Windows.Input.KeyBinding(new RelayCommand(_ => OpenLogWindow_Click(null, null)), System.Windows.Input.Key.E, System.Windows.Input.ModifierKeys.Control));

            // load settings
            _settings = AppSettings.Load();
            _autoOpenLogs = _settings.AutoOpenLogs;
            chkAutoOpen.IsChecked = _autoOpenLogs;
            txtLogPath.Text = _settings.LogFilePath ?? string.Empty;
            sldFlushInterval.Value = _settings.FlushIntervalMs > 0 ? _settings.FlushIntervalMs : 200;
            txtFlushValue.Text = sldFlushInterval.Value.ToString();
            if (_settings.StreamLogs && !string.IsNullOrWhiteSpace(_settings.LogFilePath))
            {
                chkStreamLogs.IsChecked = true;
                StartStreamLogs(_settings.LogFilePath);
            }

            // populate dynamic repositories from settings
            PopulateRepositoriesFromSettings();
        }

        private void PopulateRepositoriesFromSettings()
        {
            try
            {
                DynamicRepoPanel.Children.Clear();
                lstRepos?.Items.Clear();
                foreach (var repo in _settings.Repositories ?? new System.Collections.Generic.List<RepositoryEntry>())
                {
                    var cb = new CheckBox
                    {
                        Content = repo.Name ?? repo.Path,
                        Tag = repo.Path,
                        Foreground = BrushFromHex("#CBD5E1"),
                        Margin = new System.Windows.Thickness(0, 0, 15, 0)
                    };
                    cb.Checked += CheckBox_Changed;
                    cb.Unchecked += CheckBox_Changed;
                    DynamicRepoPanel.Children.Add(cb);
                    lstRepos?.Items.Add($"{repo.Name} | {repo.Path}");
                }
            }
            catch { }
        }

        private void AddRepo_Click(object sender, RoutedEventArgs e)
        {
            var name = txtRepoName?.Text?.Trim();
            var path = txtRepoPath?.Text?.Trim();
            if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(path))
            {
                MessageBox.Show("Please provide both name and path for the repository.", "Input required", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            _settings.Repositories ??= new List<RepositoryEntry>();
            _settings.Repositories.Add(new RepositoryEntry { Name = name, Path = path });
            _settings.Save();
            PopulateRepositoriesFromSettings();
            txtRepoName.Text = string.Empty;
            txtRepoPath.Text = string.Empty;
        }

        private void RemoveRepo_Click(object sender, RoutedEventArgs e)
        {
            if (lstRepos == null || lstRepos.SelectedIndex < 0)
            {
                MessageBox.Show("Select a repository in the list to remove.", "No selection", MessageBoxButton.OK, MessageBoxImage.Information);
                return;
            }

            var selected = lstRepos.SelectedItem.ToString();
            var parts = selected.Split('|');
            if (parts.Length >= 2)
            {
                var path = parts[1].Trim();
                var toRemove = _settings.Repositories.FirstOrDefault(r => string.Equals(r.Path, path, StringComparison.OrdinalIgnoreCase));
                if (toRemove != null)
                {
                    _settings.Repositories.Remove(toRemove);
                    _settings.Save();
                    PopulateRepositoriesFromSettings();
                }
            }
        }
        // Helper to convert hex color to brush
        private static System.Windows.Media.Brush BrushFromHex(string hex)
        {
            try
            {
                var conv = new System.Windows.Media.BrushConverter();
                return (System.Windows.Media.Brush?)conv.ConvertFromString(hex) ?? System.Windows.Media.Brushes.White;
            }
            catch
            {
                return System.Windows.Media.Brushes.White;
            }
        }

