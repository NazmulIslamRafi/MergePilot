<Controls:MetroWindow x:Class="MergePilot.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      xmlns:Ease="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore"
                      Title="Merge Pilot"
                      MinWidth="1000"
                      MinHeight="800"
                      MaxHeight="800"
                      MaxWidth="1000"
                      WindowStartupLocation="CenterScreen"
                      Background="#0A192F"
                      GlowBrush="#60A5FA"
                      BorderThickness="0"
                      WindowTransitionsEnabled="True"
                      Closing="MetroWindow_Closing">

    <Controls:MetroWindow.Resources>

        <Style TargetType="CheckBox" x:Key="ResponsiveCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
        </Style>
        <LinearGradientBrush x:Key="NormalGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0369A1" Offset="1"/>
        </LinearGradientBrush>

    </Controls:MetroWindow.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="15" Padding="22" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <!--<TextBlock Grid.Row="0" Text="🚀 Merge Pilot"
                           Foreground="#60A5FA"
                           FontSize="30"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           TextDecorations="Underline"/>-->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,12">
                    <!-- Merge Icon -->
                    <materialDesign:PackIcon Kind="SourceMerge" 
                             Width="30" 
                             Height="30" 
                             Foreground="#60A5FA"
                             VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock Text="Merge Pilot"
               Foreground="#60A5FA"
               FontSize="30"
               FontWeight="Bold"
               FontFamily="Segoe UI"
               VerticalAlignment="Center"
               TextDecorations="Underline"/>
                </StackPanel>

                <!-- Target Repository -->
                <TextBlock Grid.Row="1" Text="Select Target Repository :"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Margin="0 8 0 6"/>
                <StackPanel x:Name="RepoStackPanel" Grid.Row="2" Orientation="Vertical" Margin="0 0 0 12">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8" HorizontalAlignment="Right">
                        <Button Content="Manage Repositories" Click="ManageRepos_Click" Style="{StaticResource MaterialDesignRaisedButton}" Height="28"/>
                    </StackPanel>

                    <!-- Dynamic repository checkboxes will be added here at runtime -->
                    <StackPanel x:Name="DynamicRepoPanel" Orientation="Vertical" />

                    <!-- Repository management panel (collapsed by default) -->
                    <StackPanel x:Name="RepoManagePanel" Orientation="Vertical" Visibility="Collapsed" Margin="0 8 0 0">
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                            <TextBox x:Name="txtRepoName" Width="220" Height="26" Margin="0 0 8 0" PlaceholderText="Repo friendly name" />
                            <TextBox x:Name="txtRepoPath" Width="420" Height="26" Margin="0 0 8 0" PlaceholderText="Local path to repository" />
                            <Button x:Name="btnAddRepo" Content="Add Repo" Width="90" Height="26" Click="AddRepo_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <ListBox x:Name="lstRepos" Width="720" Height="120" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 6 0 0">
                            <Button x:Name="btnRemoveRepo" Content="Remove Selected" Width="120" Height="26" Click="RemoveRepo_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                


                <!-- Source Branch -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 6 0 8">
                    <TextBlock Text="Source Branch :"
                               Foreground="#CBD5E1"
                               FontSize="15"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="0 0 12 0"/>
                    <ComboBox x:Name="SourceBranchBox"
                              Style="{StaticResource ResponsiveComboBoxStyle}"
                              SelectedIndex="0" Width="320">
                        <ComboBoxItem Content="develop" FontSize="14"/>
                        <ComboBoxItem Content="==========FirstTrip==========" FontSize="14"/>
                        
                        <ComboBoxItem Content="b2c-first-trip/deployment-dev" FontSize="14"/>
                        <ComboBoxItem Content="b2c-first-trip/deployment-stage" FontSize="14"/>
                        <ComboBoxItem Content="b2c-first-trip/deployment-pre-prod" FontSize="14"/>
                        <ComboBoxItem Content="b2c-first-trip/deployment-prod" FontSize="14"/>

                        <ComboBoxItem Content="==========TripLover==========" FontSize="14"/>
                        <ComboBoxItem Content="b2c-triplover/deployment-dev" FontSize="14"/>
                        <ComboBoxItem Content="b2c-triplover/deployment-stage" FontSize="14"/>
                        <ComboBoxItem Content="b2c-triplover/deployment-pre-prod" FontSize="14"/>
                        <ComboBoxItem Content="b2c-triplover/deployment-prod" FontSize="14"/>

                        <ComboBoxItem Content="==========TakeTrip==========" FontSize="14"/>
                        <ComboBoxItem Content="b2c-taketrip/deployment-dev" FontSize="14"/>
                        <ComboBoxItem Content="b2c-taketrip/deployment-stage" FontSize="14"/>
                        <ComboBoxItem Content="b2c-taketrip/deployment-pre-prod" FontSize="14"/>
                        <ComboBoxItem Content="b2c-taketrip/deployment-prod" FontSize="14"/>

                        <ComboBoxItem Content="==========TakeOff==========" FontSize="14"/>
                        <ComboBoxItem Content="b2c-takeoff/deployment-dev" FontSize="14"/>
                        <ComboBoxItem Content="b2c-takeoff/deployment-stage" FontSize="14"/>
                        <ComboBoxItem Content="b2c-takeoff/deployment-pre-prod" FontSize="14"/>
                        <ComboBoxItem Content="b2c-takeoff/deployment-prod" FontSize="14"/>

                        <ComboBoxItem Content="==========TravelChamp==========" FontSize="14"/>
                        <ComboBoxItem Content="b2c-travelchamp/deployment-dev" FontSize="14"/>
                        <ComboBoxItem Content="b2c-travelchamp/deployment-stage" FontSize="14"/>
                        <ComboBoxItem Content="b2c-travelchamp/deployment-pre-prod" FontSize="14"/>
                        <ComboBoxItem Content="b2c-travelchamp/deployment-prod" FontSize="14"/>
                    </ComboBox>
                </StackPanel>

                <!-- Target Environments -->
                <TextBlock Grid.Row="4" Text="Select Target Environments :"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Margin="0 8 0 6"/>
                <StackPanel x:Name="EnvStackPanel" Grid.Row="5" Orientation="Horizontal" Margin="0 0 0 10" HorizontalAlignment="Left">
                    <CheckBox x:Name="chkAllCheckUncheck" Content="All" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="chkAllCheckUncheck_Checked" Unchecked="chkAllCheckUncheck_Checked" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkDev" Content="Dev" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkStage" Content="Stage" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkPreProd" Content="Pre-Prod" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkProd" Content="Prod" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1"/>
                </StackPanel>

                <!-- Client Branches -->
                <TextBlock Grid.Row="6" Text="Select Target Client Branch :"
                           Foreground="#CBD5E1"
                           FontSize="15"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Margin="0 8 0 6"/>
                <WrapPanel x:Name="ClientWrapPanel" Grid.Row="7" Margin="0 0 0 12" ItemHeight="30" ItemWidth="140" Orientation="Horizontal">
                    <CheckBox x:Name="chkClientCheckUncheck" Content="All" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="chkClientCheckUncheck_Checked" Unchecked="chkClientCheckUncheck_Checked" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkFirsttrip" Tag="b2c-first-trip" Content="FirstTrip" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1" Margin="0 0 15 0"/>
                    <CheckBox x:Name="chkTriplover" Tag="b2c-triplover" Content="TripLover" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1" Margin="0 0 15 0"/>
                    <CheckBox x:Name="chkTravelchamp" Tag="b2c-travelchamp" Content="TravelChamp" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1" Margin="0 0 15 0"/>
                    <CheckBox x:Name="chkTakeoff" Tag="b2c-takeoff" Content="TakeOff" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1"/>
                    <CheckBox x:Name="chkTaketrip" Tag="b2c-taketrip" Content="TakeTrip" Style="{StaticResource ResponsiveCheckBoxStyle}" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" Foreground="#CBD5E1"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
            <Button x:Name="btnMerge"
        Grid.Row="1"
                    Content="MERGE BRANCHES"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource NormalGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    Height="50"
                    Padding="20 10"
                    Margin="0,0,8,0"
                    Click="Merge_Click"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="RocketIcon" Kind="RocketLaunch" Foreground="#FB923C" Width="20" Height="20" Margin="0 0 8 0">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverGradientBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NormalGradientBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="RocketAnimStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation
                                                Storyboard.TargetName="RocketIcon"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="0" To="-6"
                                                Duration="0:0:0.6"
                                                AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Opacity" Value="0.7"/>
                                <Trigger.EnterActions>
                                    <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnPullBranches"
                    Content="PULL BRANCHES"
                    ToolTip="Fetch latest branches from origin for selected repositories"
                    Click="PullSelectedBranches_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{StaticResource NormalGradientBrush}"
                    Foreground="White"
                    FontWeight="Bold"
                    Height="50"
                    Padding="20 10"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="PullIcon" Kind="Download" Foreground="#60A5FA" Width="20" Height="20" Margin="0 0 8 0" />
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverGradientBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NormalGradientBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Output Log -->
        <DockPanel Grid.Row="2" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0 0 0 6" VerticalAlignment="Center">
                    <Button Content="Open Log Window" Width="160" Height="28" Margin="0 0 8 0" Click="OpenLogWindow_Click"/>

                    <CheckBox x:Name="chkAutoOpen" Content="Auto-open logs" VerticalAlignment="Center" Margin="0 0 12 0" Checked="chkAutoOpen_Checked" Unchecked="chkAutoOpen_Unchecked"/>

                    <CheckBox x:Name="chkStreamLogs" Content="Stream Logs" VerticalAlignment="Center" Margin="0 0 6 0" Checked="chkStreamLogs_Checked" Unchecked="chkStreamLogs_Unchecked"/>
                    <TextBox x:Name="txtLogPath" Width="300" Height="26" IsReadOnly="True" Margin="0 0 6 0" VerticalAlignment="Center"/>
                    <Button Content="…" Width="28" Height="26" Click="SelectLogPath_Click" />

                    <!-- Streaming indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 12 0">
                        <Ellipse x:Name="ellipseStreamIndicator" Width="12" Height="12" Fill="#475569" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" ToolTip="Streaming disabled" />
                    </StackPanel>

                    <!-- Flush interval slider -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 0">
                        <TextBlock Text="Flush (ms):" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <Slider x:Name="sldFlushInterval" Minimum="100" Maximum="1000" Width="160" ValueChanged="sldFlushInterval_ValueChanged"/>
                        <TextBlock x:Name="txtFlushValue" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6 0 0 0"/>
                    </StackPanel>
                </StackPanel>
        </DockPanel>
        <!--<TextBlock Grid.Row="2" Text="Output Log:"
                   Foreground="#CBD5E1"
                   FontSize="16"
                   FontWeight="Medium"
                   FontFamily="Segoe UI"
                   Margin="0 10 0 10"/>
        <ScrollViewer Grid.Row="3" Height="200" Background="#111827" Padding="10" VerticalScrollBarVisibility="Auto">
            <Border CornerRadius="10" Background="#1F2937">
                <TextBlock x:Name="OutputBox"
                           Foreground="#E2E8F0"
                           FontFamily="Consolas"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Padding="10"/>
            </Border>
        </ScrollViewer>-->
        <Border Grid.Row="2" CornerRadius="15" Padding="0" >
            <!-- Parent Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Output Log -->
                    <ColumnDefinition Width="*"/>
                    <!-- Error Log -->
                </Grid.ColumnDefinitions>

                <!-- Output Log (moved to popup window) -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Output Log is available in a separate window"
                       Foreground="#CBD5E1"
                       FontSize="14"
                       FontWeight="Normal"
                       FontFamily="Segoe UI"
                       Margin="0 10 0 10"/>
                </StackPanel>

                <!-- Error Log (moved to popup window) -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Error Log is available in a separate window"
                               Foreground="#F87171"
                               FontSize="14"
                               FontWeight="Normal"
                               FontFamily="Segoe UI"
                               Margin="0 10 0 10"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="Developed by Md Nazmul Islam"
                   Foreground="#64748B"
                   FontSize="14"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Right"
                   Margin="0 20 0 20"/>
    </Grid>
</Controls:MetroWindow>