        // Helper class for tree-wise branch display
        private class BranchTreeItem : System.ComponentModel.INotifyPropertyChanged
        {
            private string _name = string.Empty;
            private string _fullPath = string.Empty;
            private List<BranchTreeItem> _children = new List<BranchTreeItem>();
            private bool? _isChecked;
            private bool _isExpanded;
            private bool _isBranch;

            public string Name { get => _name; set { _name = value; OnPropertyChanged(nameof(Name)); } }
            public string FullPath { get => _fullPath; set { _fullPath = value; OnPropertyChanged(nameof(FullPath)); } } // Full branch name (e.g., "feature/auth" or "0-Task/NewVersion")
            public List<BranchTreeItem> Children { get => _children; set { _children = value; OnPropertyChanged(nameof(Children)); } }
            // UI helpers for checkbox and expansion state
            public bool? IsChecked { get => _isChecked; set { if (_isChecked != value) { _isChecked = value; OnPropertyChanged(nameof(IsChecked)); } } }
            public bool IsExpanded { get => _isExpanded; set { if (_isExpanded != value) { _isExpanded = value; OnPropertyChanged(nameof(IsExpanded)); } } }
            // True when this node corresponds to an actual branch (not just a folder)
            public bool IsBranch { get => _isBranch; set { if (_isBranch != value) { _isBranch = value; OnPropertyChanged(nameof(IsBranch)); } } }
            public override string ToString() => Name;

            public event System.ComponentModel.PropertyChangedEventHandler? PropertyChanged;
            private void OnPropertyChanged(string propName) => PropertyChanged?.Invoke(this, new System.ComponentModel.PropertyChangedEventArgs(propName));
        }

        // Build hierarchical tree from flat branch names
        private List<BranchTreeItem> BuildBranchTree(IEnumerable<string> branches)
        {
            var root = new List<BranchTreeItem>();
            var pathMap = new Dictionary<string, BranchTreeItem>(StringComparer.OrdinalIgnoreCase);
            var all = new HashSet<string>(branches, StringComparer.OrdinalIgnoreCase);

            foreach (var fullBranch in all.OrderBy(b => b))
            {
                var parts = fullBranch.Split('/');
                var currentPath = "";
                BranchTreeItem parent = null;

                for (int i = 0; i < parts.Length; i++)
                {
                    var part = parts[i];
                    currentPath = string.IsNullOrEmpty(currentPath) ? part : $"{currentPath}/{part}";

                    if (!pathMap.TryGetValue(currentPath, out var item))
                    {
                        item = new BranchTreeItem
                        {
                            Name = part,
                            FullPath = currentPath,
                            // set IsBranch later after tree is built (parents should act only as folders)
                            IsBranch = false,
                            // load persisted checked state (tri-state)
                            IsChecked = _settings.BranchCheckedState != null && _settings.BranchCheckedState.TryGetValue(currentPath, out var chk) ? chk : false,
                            // default collapsed unless persisted
                            IsExpanded = _settings.BranchExpandedState != null && _settings.BranchExpandedState.TryGetValue(currentPath, out var ex) ? ex : false
                        };
                        pathMap[currentPath] = item;

                        if (parent == null)
                            root.Add(item);
                        else
                            parent.Children.Add(item);
                    }

                    parent = item;
                }
            }

            // After building all nodes, mark nodes that correspond to actual branches
            foreach (var b in all)
            {
                if (pathMap.TryGetValue(b, out var node))
                {
                    node.IsBranch = true;
                }
            }

            // Attach property-changed handlers so that when a node's IsChecked changes
            // (including from UI or programmatically) we propagate the state to its children
            void Attach(IEnumerable<BranchTreeItem> nodes)
            {
                foreach (var n in nodes)
                {
                    n.PropertyChanged += (s, e) =>
                    {
                        try
                        {
                            if (e.PropertyName == nameof(BranchTreeItem.IsChecked) && s is BranchTreeItem changed)
                            {
                                // propagate to children when parent toggled
                                SetChildrenCheckedState(changed, changed.IsChecked);
                                RecomputeAllParentStates();
                                PersistBranchStates();
                                ValidateSelections();
                            }
                        }
                        catch { }
                    };

                    if (n.Children.Count > 0) Attach(n.Children);
                }
            }

            Attach(root);

            return root;
        }

        // Extract all selected branch full paths from TreeView (including parent and leaf nodes)
        private List<string> GetSelectedBranchesFromTree(System.Windows.Controls.TreeView treeView)
        {
            var selected = new List<string>();
            if (treeView?.ItemsSource is IEnumerable<BranchTreeItem> roots)
            {
                void Collect(BranchTreeItem node)
                {
                    if (node.IsChecked == true && node.IsBranch && !string.IsNullOrEmpty(node.FullPath))
                        selected.Add(node.FullPath);
                    foreach (var c in node.Children)
                        Collect(c);
                }

                foreach (var r in roots)
                    Collect(r);
            }
            return selected;
        }

        // Get all selected leaf branches from TreeView recursively (only actual branch names, not categories)
        private List<string> GetAllSelectedBranchesFromTree(System.Windows.Controls.TreeView treeView)
        {
            var selected = new List<string>();
            if (treeView?.ItemsSource is IEnumerable<BranchTreeItem> roots)
            {
                void CollectLeaves(BranchTreeItem node)
                {
                    if (node.IsBranch && node.IsChecked == true && !string.IsNullOrEmpty(node.FullPath))
                    {
                        // include branch nodes (leaf or parent that is also a branch)
                        selected.Add(node.FullPath);
                    }
                    foreach (var c in node.Children)
                        CollectLeaves(c);
                }

                foreach (var r in roots)
                    CollectLeaves(r);
            }

            return selected;
        }

