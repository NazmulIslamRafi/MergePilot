                    _settings.Repositories.RemoveAt(idx);
                    _settings.Save();
                    PopulateRepositoriesFromSettings();
                    // ensure selection reflects change
                    if (lstRepos.Items.Count > idx) lstRepos.Items.RemoveAt(idx);
                }
            }
            catch (Exception ex)
            {
                AppendError($"Failed to remove repository: {ex.Message}");
            }
        }

        private async void Merge_Click(object sender, RoutedEventArgs e)
        {
            var cts = new CancellationTokenSource();
            btnMerge.IsEnabled = false;
            ButtonProgressAssist.SetIsIndeterminate(btnMerge, true);

            // Get single source branch (Merge requires exactly 1 source branch)
            var selectedSources = GetAllSelectedBranchesFromTree(SourceBranchTree);
            if (selectedSources.Count != 1)
            {
                AppendError($"❌ For merge operation, select exactly 1 source branch. You selected {selectedSources.Count}.");
                btnMerge.IsEnabled = true;
                ButtonProgressAssist.SetIsIndeterminate(btnMerge, false);
                return;
            }

            var sourceItem = selectedSources[0];
            if (string.IsNullOrWhiteSpace(sourceItem))
            {
                AppendError("❌ Source branch is empty. Please select a source branch.");
                btnMerge.IsEnabled = true;
                ButtonProgressAssist.SetIsIndeterminate(btnMerge, false);
                return;
            }

            // Get multiple target branches
            var targetBranches = GetAllSelectedBranchesFromTree(TargetBranchTree);

            if (targetBranches.Count == 0)
            {
                AppendError("❌ No target branches selected. Please select at least one target branch.");
                btnMerge.IsEnabled = true;
                ButtonProgressAssist.SetIsIndeterminate(btnMerge, false);
                return;
            }

            var repoPaths = GetSelectedRepositories();
            string source = sourceItem.Trim();

            AppendOutput($"\n🚀 Merge Started (Retry ×3 | Auto-Skip | No Editor)");
            AppendOutput($"Source Branch: {source}");
            AppendOutput($"Target Branches: {string.Join(", ", targetBranches)}");
            AppendOutput($"Repositories: {repoPaths.Count}\n");

            try
            {
                // Run background merge workflow on thread-pool to keep UI thread free.
                await Task.Run(() => DoMergeAsync(source, targetBranches, repoPaths, cts.Token));
            }
            catch (OperationCanceledException)
            {
                AppendError("Operation cancelled by user");
            }
            catch (Exception ex)
            {
                AppendError($"Merge failed: {ex.Message}");
            }
            finally
            {
                // Marshal final UI updates back to UI thread
                Dispatcher.Invoke(() =>
                {
                    ButtonProgressAssist.SetIsIndeterminate(btnMerge, false);
                    btnMerge.IsEnabled = true;
                });

                cts.Dispose();
            }
        }

        private async Task DoMergeAsync(string source, List<string> targetBranches, List<string> repoPaths, CancellationToken token)
        {
            var successList = new List<string>();
            var skipList = new List<string>();
            var failList = new List<string>();

            try
            {
                // Persist last used branches (safe off UI thread)
                _settings.LastSourceBranch = source;
                _settings.LastTargetBranch = string.Join("|", targetBranches);
                _settings.Save();

                foreach (var repo in repoPaths)
                {
                    AppendOutput($"📁 Project: {System.IO.Path.GetFileName(repo)}");
                    AppendOutput("═".PadRight(50, '═'));

                    if (!Directory.Exists(repo) || !Directory.Exists(System.IO.Path.Combine(repo, ".git")))
                    {
                        AppendError($"❌ Repository path not found or not a git repo: {repo}");
                        failList.Add($"{repo} | all branches | repo not found");
                        continue;
                    }

                    foreach (var targetBranch in targetBranches)
                    {
                        AppendOutput($"🔁 {System.IO.Path.GetFileName(repo)} → {targetBranch}");
                        AppendOutput($"🕒 $(date '+%Y-%m-%d %H:%M:%S')");
                        AppendOutput("───────────────────────────────────────────────");

                        try
                        {
                            // Validate target branch exists on remote (using detected remote)
                            var remoteName = await GitHelper.GetDefaultRemoteNameAsync(repo, token).ConfigureAwait(false);
                            var existsOnRemote = await GitHelper.RemoteBranchExistsAsync(repo, remoteName, targetBranch, token).ConfigureAwait(false);
                            if (!existsOnRemote)
                            {
                                var ask = Dispatcher.Invoke(() => System.Windows.MessageBox.Show($"Target branch '{targetBranch}' was not found on '{remoteName}' for repo '{repo}'.\n\nDo you want to continue anyway?", "Target branch not found", MessageBoxButton.YesNo, MessageBoxImage.Warning));
                                if (ask != MessageBoxResult.Yes)
                                {
                                    failList.Add($"{repo} | {targetBranch} | target not on remote");
                                    AppendError($"⏭ Skipped (target not on remote)");
                                    continue;
                                }
                            }

                            // Checkout target branch with retry
                            bool checkoutSuccess = false;
                            for (int attempt = 1; attempt <= 3; attempt++)
                            {
                                AppendOutput($"🔄 Checking out {targetBranch} (Attempt {attempt}/3)...");

                                try
                                {
                                    await GitHelper.CheckoutBranchAsync(repo, targetBranch, token).ConfigureAwait(false);
                                    checkoutSuccess = true;
                                    break;
                                }
                                catch (Exception ex)
                                {
                                    if (attempt < 3)
                                        await Task.Delay(2000, token).ConfigureAwait(false);
                                    else
                                        AppendError($"❌ Checkout failed after 3 attempts: {ex.Message}");
                                }
                            }

                            if (!checkoutSuccess)
                            {
                                failList.Add($"{repo} | {targetBranch} | checkout failed");
                                continue;
                            }

                            // Pull latest with retry
                            bool pullSuccess = false;
                            for (int attempt = 1; attempt <= 3; attempt++)
                            {
                                AppendOutput($"🔄 Pulling latest (Attempt {attempt}/3)...");

                                try
                                {
                                    await GitHelper.PullBranchAsync(repo, targetBranch, token).ConfigureAwait(false);
                                    pullSuccess = true;
                                    break;
                                }
                                catch (Exception ex)
                                {
                                    if (attempt < 3)
                                        await Task.Delay(2000, token).ConfigureAwait(false);
                                    else
                                        AppendError($"❌ Pull failed after 3 attempts: {ex.Message}");
                                }
                            }

                            if (!pullSuccess)
                            {
                                failList.Add($"{repo} | {targetBranch} | pull failed");
                                continue;
                            }

                            // Auto skip if already merged
                            try
                            {
                                var isMerged = await GitHelper.IsBranchMergedAsync(repo, remoteName, source, targetBranch, token).ConfigureAwait(false);
                                if (isMerged)
                                {
                                    AppendOutput($"⏭ Source already merged — skipping");
                                    skipList.Add($"{repo} | {targetBranch}");
                                    continue;
                                }
                            }
                            catch { }

                            // Merge with retry
                            bool mergeSuccess = false;
                            for (int attempt = 1; attempt <= 3; attempt++)
                            {
                                AppendOutput($"🔄 Merging {source} into {targetBranch} (Attempt {attempt}/3)...");

                                try
                                {
                                    await GitHelper.MergeBranchAsync(repo, remoteName, source, false, token).ConfigureAwait(false);
                                    mergeSuccess = true;
                                    AppendOutput($"✔ Merge successful");
                                    break;
                                }
                                catch (Exception mergeEx)
                                {
                                    if (mergeEx.Message.Contains("conflict", StringComparison.OrdinalIgnoreCase))
                                    {
                                        AppendError($"❌ Merge conflict detected");
                                        var result = Dispatcher.Invoke(() => System.Windows.MessageBox.Show($"Merge conflict in {repo}/{targetBranch}.\n\nResolve manually and continue?", "Merge Conflict", MessageBoxButton.YesNo, MessageBoxImage.Warning));
                                        if (result == MessageBoxResult.Yes)
                                        {
                                            // User will resolve manually
                                            failList.Add($"{repo} | {targetBranch} | merge conflict (manual resolution)");
                                        }
                                        else
                                        {
                                            await GitHelper.AbortMergeAsync(repo, token).ConfigureAwait(false);
                                            failList.Add($"{repo} | {targetBranch} | merge conflict");
                                        }
                                        mergeSuccess = false;
                                        break;
                                    }
                                    else if (attempt < 3)
                                    {
                                        await Task.Delay(2000, token).ConfigureAwait(false);
                                    }
                                    else
                                    {
                                        AppendError($"❌ Merge failed after 3 attempts: {mergeEx.Message}");
                                    }
                                }
                            }

                            if (!mergeSuccess)
                            {
                                continue;
                            }

                            // Push with retry
                            bool pushSuccess = false;
                            for (int attempt = 1; attempt <= 3; attempt++)
                            {
                                AppendOutput($"🔄 Pushing changes (Attempt {attempt}/3)...");

                                try
                                {
                                    await GitHelper.PushBranchAsync(repo, targetBranch, token).ConfigureAwait(false);
                                    pushSuccess = true;
                                    break;
                                }
                                catch (Exception ex)
                                {
                                    if (attempt < 3)
                                        await Task.Delay(2000, token).ConfigureAwait(false);
                                    else
                                        AppendError($"❌ Push failed after 3 attempts: {ex.Message}");
                                }
                            }

                            if (!pushSuccess)
                            {
                                failList.Add($"{repo} | {targetBranch} | push failed");
                                continue;
                            }

                            successList.Add($"{repo} | {targetBranch}");
                            AppendOutput($"🚀 Done: {targetBranch}\n");
                        }
                        catch (OperationCanceledException)
                        {
                            AppendError("❌ Operation cancelled");
                            failList.Add($"{repo} | {targetBranch} | cancelled");
                        }
                        catch (Exception ex)
                        {
                            AppendError($"❌ Error processing {targetBranch}: {ex.Message}");
                            failList.Add($"{repo} | {targetBranch} | {ex.Message}");
                        }
                    }

                    AppendOutput($"✅ Completed: {System.IO.Path.GetFileName(repo)}\n");
                }

                // Generate final summary
                GenerateAndLogSummary("Merge Branches Summary", successList, skipList, failList);
            }
            catch (OperationCanceledException)
            {
                AppendError("Operation cancelled by user");
            }
            catch (Exception ex)
            {
                AppendError($"Merge failed: {ex.Message}");
            }
        }

