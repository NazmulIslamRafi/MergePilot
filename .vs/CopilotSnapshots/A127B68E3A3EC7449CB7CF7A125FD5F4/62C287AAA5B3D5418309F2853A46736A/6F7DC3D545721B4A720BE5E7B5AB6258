        private void AppendOutput(string text)
        {
            var timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            var line = $"[{timestamp}] {text}\n";
            _outputQueue.Enqueue(line);
            // _outputMaster is updated only on the UI thread inside FlushLogQueues to avoid cross-thread access
        }

        private void AppendError(string text)
        {
            var timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            var line = $"[{timestamp}] {text}\n";
            _errorQueue.Enqueue(line);
            // _errorMaster is updated only on the UI thread inside FlushLogQueues to avoid cross-thread access
        }

        private void FlushLogQueues()
        {
            try
            {
                // Flush output queue into inline OutputBox
                if (_outputQueue.Count > 0)
                {
                    var sb = new StringBuilder();
                    while (_outputQueue.TryDequeue(out var item))
                        sb.Append(item);

                    if (sb.Length > 0)
                    {
                        var text = sb.ToString();
                         try
                         {
                             if (OutputBox != null)
                             {
                                 OutputBox.AppendText(text);
                                 _outputMaster.Append(text);
                                 var max = _settings?.LogMaxChars > 0 ? _settings.LogMaxChars : MaxLogChars;
                                 if (_outputMaster.Length > max)
                                     _outputMaster.Remove(0, _outputMaster.Length - max);
                             }

                             if (_streamLogsToFile && _logFileWriter != null)
                             {
                                 _logFileWriter.Write(text);
                                 _logFileWriter.Flush();
                             }
                         }
                         catch { }

                     }
                 }

                 // Flush error queue into inline log (simplified - errors appended to same log)
                if (_errorQueue.Count > 0)
                {
                    var sb2 = new StringBuilder();
                    while (_errorQueue.TryDequeue(out var item))
                        sb2.Append(item);

                    if (sb2.Length > 0)
                    {
                        var text2 = sb2.ToString();
                        try
                        {
                             if (OutputBox != null)
                             {
                                 OutputBox.AppendText(text2);
                                 _errorMaster.Append(text2);
                                 var max = _settings?.LogMaxChars > 0 ? _settings.LogMaxChars : MaxLogChars;
                                 if (_errorMaster.Length > max)
                                     _errorMaster.Remove(0, _errorMaster.Length - max);
                             }

                             if (_streamLogsToFile && _logFileWriter != null)
                             {
                                 _logFileWriter.Write(text2);
                                 _logFileWriter.Flush();
                             }
                         }
                         catch { }
                     }
                 }
             }
             catch
             {
                 // swallow logging errors
             }
         }

        private void TreeView_PreviewKeyDown(object sender, System.Windows.Input.KeyEventArgs e)
        {
            try
            {
                if (sender is System.Windows.Controls.TreeView tree)
                {
                    if (e.Key == Key.Space)
                    {
                        // toggle focused item checkbox
                        var focused = Keyboard.FocusedElement as DependencyObject;
                        while (focused != null && !(focused is System.Windows.Controls.TreeViewItem))
                            focused = VisualTreeHelper.GetParent(focused);
                        if (focused is System.Windows.Controls.TreeViewItem tvi && tvi.DataContext is BranchTreeItem item)
                        {
                            bool? newState = !(item.IsChecked == true);
                            item.IsChecked = newState;
                            SetChildrenCheckedState(item, newState);
                            RecomputeAllParentStates();
                            PersistBranchStates();
                            ValidateSelections();
                        }
                        e.Handled = true;
                    }
                    else if (e.Key == Key.A && (Keyboard.Modifiers & ModifierKeys.Control) == ModifierKeys.Control)
                    {
                        // select/check all leaves
                        var list = GetAllBranchTreeItems(tree);
                        foreach (var it in list)
                            it.IsChecked = true;
                        ValidateSelections();
                        e.Handled = true;
                    }
                }
            }
            catch { }
        }

        private void BranchCheckBox_Changed(object sender, RoutedEventArgs e)
        {
            try
            {
                if (sender is CheckBox cb && cb.DataContext is BranchTreeItem item)
                {
                    // Prevent unnecessary re-entrance when parent states are auto-updated
                    bool? newState = cb.IsChecked;
                    
                    // Only propagate changes if this is a user-initiated change (not a parent auto-update)
                    // Check if any children have a different state than the parent
                    bool isUserInitiated = item.Children.Count == 0 || 
                                          item.Children.Any(c => c.IsChecked != newState);
                    
                    if (isUserInitiated)
                    {
                        // propagate to children only when user directly changes this item
                        SetChildrenCheckedState(item, newState);
                    }
                    
                    // recompute all parent states (will set indeterminate state correctly)
                    RecomputeAllParentStates();
                    
                    // persist
                    PersistBranchStates();
                    ValidateSelections();
                    UpdateBranchToggleSummary();
                }
            }
            catch { }
        }

        private void RecomputeAllParentStates()
        {
            void Recurse(IEnumerable<BranchTreeItem> nodes)
            {
                foreach (var node in nodes)
                {
                    if (node.Children.Count > 0)
                    {
                        Recurse(node.Children);
                        int total = node.Children.Count;
                        int checkedCount = node.Children.Count(c => c.IsChecked == true);
                        int uncheckedCount = node.Children.Count(c => c.IsChecked == false);
                        if (checkedCount == total)
                            node.IsChecked = true;
                        else if (uncheckedCount == total)
                            node.IsChecked = false;
                        else
                            node.IsChecked = null; // indeterminate
                    }
                }
            }

            if (SourceBranchTree?.ItemsSource is IEnumerable<BranchTreeItem> roots)
                Recurse(roots);
            if (TargetBranchTree?.ItemsSource is IEnumerable<BranchTreeItem> roots2)
                Recurse(roots2);
        }

        private void PersistBranchStates()
        {
            try
            {
                _settings.BranchCheckedState = new Dictionary<string, bool?>();
                _settings.BranchExpandedState = new Dictionary<string, bool>();

                void Collect(IEnumerable<BranchTreeItem> nodes)
                {
                    foreach (var n in nodes)
                    {
                        _settings.BranchCheckedState[n.FullPath] = n.IsChecked;
                        _settings.BranchExpandedState[n.FullPath] = n.IsExpanded;
                        if (n.Children.Count > 0) Collect(n.Children);
                    }
                }

                if (SourceBranchTree?.ItemsSource is IEnumerable<BranchTreeItem> sroots) Collect(sroots);
                if (TargetBranchTree?.ItemsSource is IEnumerable<BranchTreeItem> troots) Collect(troots);

                _settings.Save();
            }
            catch { }
        }

        private void SetChildrenCheckedState(BranchTreeItem parent, bool? isChecked)
        {
            if (parent == null) return;
            foreach (var child in parent.Children)
            {
                child.IsChecked = isChecked;
                if (child.Children.Count > 0)
                    SetChildrenCheckedState(child, isChecked);
            }
        }

        private List<BranchTreeItem> GetAllBranchTreeItems(System.Windows.Controls.TreeView tree)
        {
            var list = new List<BranchTreeItem>();
            if (tree?.ItemsSource is IEnumerable<BranchTreeItem> roots)
            {
                void Collect(BranchTreeItem node)
                {
                    list.Add(node);
                    foreach (var c in node.Children)
                        Collect(c);
                }
                foreach (var r in roots)
                    Collect(r);
            }
            return list;
        }

        private void ExpandAllTreeItems(System.Windows.Controls.TreeView tree)
        {
            if (tree == null) return;
            void Expand(ItemCollection items)
            {
                foreach (var obj in items)
                {
                    var tvi = tree.ItemContainerGenerator.ContainerFromItem(obj) as System.Windows.Controls.TreeViewItem;
                    if (tvi != null)
                    {
                        tvi.IsExpanded = true;
                        if (tvi.Items.Count > 0)
                            Expand(tvi.Items);
                    }
                }
            }
            Expand(tree.Items);
        }

