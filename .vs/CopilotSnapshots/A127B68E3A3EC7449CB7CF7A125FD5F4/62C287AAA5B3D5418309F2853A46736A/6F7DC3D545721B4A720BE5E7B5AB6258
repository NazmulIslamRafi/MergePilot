        private void PopulateRepositoriesFromSettings()
        {
            try
            {
                DynamicRepoPanel.Children.Clear();
                lstRepos?.Items.Clear();
                foreach (var repo in _settings.Repositories ?? new System.Collections.Generic.List<AppSettings.RepositoryEntry>())
                {
                    var cb = new CheckBox
                    {
                        Content = repo.Name ?? repo.Path,
                        Tag = repo.Path,
                        Foreground = BrushFromHex("#CBD5E1"),
                        Margin = new System.Windows.Thickness(0, 0, 15, 0)
                    };
                    cb.Checked += CheckBox_Changed;
                    cb.Unchecked += CheckBox_Changed;
                    DynamicRepoPanel.Children.Add(cb);
                    // Add ListBoxItem with Tag set to path so selection can map back to dynamic checkbox
                    try
                    {
                        if (lstRepos != null)
                        {
                            lstRepos.Items.Add(repo);
                        }
                    }
                    catch { }
                }

                // Load recent branches into ListBoxes (async to avoid blocking UI)
                _ = RefreshBranchListsAsync();
            }
            catch (Exception ex)
            {
                AppendError($"PopulateRepositoriesFromSettings failed: {ex.Message}");
            }
        }

        private async Task RefreshBranchListsAsync()
        {
            try
            {
                // Clear current items promptly on UI thread
                await Dispatcher.InvokeAsync(() =>
                {
                    SourceBranchTree.ItemsSource = null;
                    TargetBranchTree.ItemsSource = null;
                });

                // Get selected repositories
                var selectedRepos = GetSelectedRepositories();
                if (selectedRepos.Count == 0)
                {
                    AppendOutput("ℹ️  No repositories selected. Please select at least one repository to load branches.");
                    return;
                }

                AppendOutput($"📥 Loading branches from {selectedRepos.Count} repository(ies)...");

                // Collect branches from all selected repositories
                var allBranches = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                foreach (var repo in selectedRepos)
                {
                    try
                    {
                        // Get remote branches from origin (not local branches)
                        var remoteName = await GitHelper.GetDefaultRemoteNameAsync(repo).ConfigureAwait(false);

                        // Use ls-remote to get remote branch list
                        var result = await GitHelper.RunGitCommandAsync(repo, $"ls-remote --heads {remoteName}", TimeSpan.FromSeconds(30)).ConfigureAwait(false);

                        if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.StdOut))
                        {
                            // Parse output: format is "<sha>\trefs/heads/<branch>"
                            foreach (var line in result.StdOut.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                var parts = line.Split(new[] { '\t', ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                if (parts.Length >= 2)
                                {
                                    var refPart = parts[1]; // refs/heads/<branch>
                                    var prefix = "refs/heads/";
                                    if (refPart.StartsWith(prefix))
                                    {
                                        var branch = refPart.Substring(prefix.Length).Trim();
                                        if (!string.IsNullOrWhiteSpace(branch))
                                        {
                                            allBranches.Add(branch);
                                        }
                                    }
                                }
                            }
                            AppendOutput($"  ✔ Loaded branches from {System.IO.Path.GetFileName(repo)}");
                        }
                        else
                        {
                            AppendError($"  ⚠️  No remote branches found for {System.IO.Path.GetFileName(repo)}");
                        }
                    }
                    catch (Exception ex)
                    {
                        AppendError($"  ❌ Failed to load branches from {System.IO.Path.GetFileName(repo)}: {ex.Message}");
                    }
                }

                // Build hierarchical tree and populate TreeViews on UI thread
                await Dispatcher.InvokeAsync(() =>
                {
                    if (allBranches.Count > 0)
                    {
                        // Build tree structure from flat branch names
                        var branchTree = BuildBranchTree(allBranches);

                        // Bind to TreeViews and ComboBox dropdowns
                        SourceBranchTree.ItemsSource = branchTree;
                        TargetBranchTree.ItemsSource = branchTree;

                        AppendOutput($"✅ Loaded {allBranches.Count} unique branches");
                        // ensure any previously persisted expansion/checked states are applied
                        RecomputeAllParentStates();
                    }
                    else
                    {
                        AppendOutput("⚠️  No branches found in selected repositories");
                    }

                    ValidateSelections();
                    UpdateBranchToggleSummary();
                });
            }
            catch (Exception ex)
            {
                AppendError($"RefreshBranchLists failed: {ex.Message}");
            }
        }

        // Helper to convert hex color to brush
        private static System.Windows.Media.Brush BrushFromHex(string hex)
        {
            try
            {
                var conv = new System.Windows.Media.BrushConverter();
                return (System.Windows.Media.Brush?)conv.ConvertFromString(hex) ?? System.Windows.Media.Brushes.White;
            }
            catch
            {
                return System.Windows.Media.Brushes.White;
            }
        }

