        private void GenerateAndLogSummary(string title, List<string> successList, List<string> skipList, List<string> failList)
        {
            try
            {
                AppendOutput($"\n╔══════════════════════════════════════════╗");
                AppendOutput($"║         {title.PadRight(38)} ║");
                AppendOutput($"╚══════════════════════════════════════════╝\n");

                if (successList.Count > 0)
                {
                    AppendOutput($"✅ SUCCESSFUL ({successList.Count}):");
                    foreach (var item in successList)
                    {
                        AppendOutput($"  ✔ {item}");
                    }
                    AppendOutput("");
                }

                if (skipList.Count > 0)
                {
                    AppendOutput($"⏭ SKIPPED (Already Merged) ({skipList.Count}):");
                    foreach (var item in skipList)
                    {
                        AppendOutput($"  ⏭ {item}");
                    }
                    AppendOutput("");
                }

                if (failList.Count > 0)
                {
                    AppendOutput($"❌ FAILED ({failList.Count}):");
                    foreach (var item in failList)
                    {
                        AppendError($"  ❌ {item}");
                    }
                    AppendOutput("");
                }

                AppendOutput("═══════════════════════════════════════════");
                AppendOutput($"🎉 All Projects Completed with Full Summary!");
                AppendOutput("");
            }
            catch (Exception ex)
            {
                AppendError($"Error generating summary: {ex.Message}");
            }
        }

