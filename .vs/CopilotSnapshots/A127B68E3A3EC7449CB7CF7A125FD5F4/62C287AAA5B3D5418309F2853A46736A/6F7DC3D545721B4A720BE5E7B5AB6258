        // Button handler to pull selected branches from origin (mirrors provided bash script behavior)
        private async void PullSelectedBranches_Click(object sender, RoutedEventArgs e)
        {
            var cts = new CancellationTokenSource();
            btnPullBranches.IsEnabled = false;
            ButtonProgressAssist.SetIsIndeterminate(btnPullBranches, true);

            var successList = new List<string>();
            var skipList = new List<string>();
            var failList = new List<string>();

            // Get source branches (Pull allows 1 or more)
            var sourceBranches = GetAllSelectedBranchesFromTree(SourceBranchTree);

            if (sourceBranches.Count == 0)
            {
                AppendError("❌ No source branches selected. Please select at least one source branch.");
                btnPullBranches.IsEnabled = true;
                ButtonProgressAssist.SetIsIndeterminate(btnPullBranches, false);
                return;
            }

            var repoPaths = GetSelectedRepositories();

            AppendOutput($"\n🚀 Pull Branches Started");
            AppendOutput($"Source Branches: {string.Join(", ", sourceBranches)}");
            AppendOutput($"Repositories: {repoPaths.Count}\n");

            try
            {
                // Iterate through each source branch
                foreach (var source in sourceBranches)
                {
                    AppendOutput($"\n📥 Processing source branch: {source}");
                    AppendOutput("═".PadRight(50, '═'));
                    
                    foreach (var repo in repoPaths)
                    {
                        AppendOutput($"📁 Project: {System.IO.Path.GetFileName(repo)}");
                        AppendOutput("═".PadRight(50, '═'));

                        if (!Directory.Exists(repo) || !Directory.Exists(System.IO.Path.Combine(repo, ".git")))
                        {
                            AppendError($"❌ Repository path not found or not a git repo: {repo}");
                            failList.Add($"{repo} | pull failed | repo not found");
                            continue;
                        }

                        AppendOutput($"🔄 Fetching {source} from origin");
                        AppendOutput("───────────────────────────────────────────────");

                        try
                        {
                            // Fetch source branch with retry
                            bool fetchSuccess = false;
                            for (int attempt = 1; attempt <= 3; attempt++)
                            {
                                AppendOutput($"🔄 Fetching {source} (Attempt {attempt}/3)...");

                                try
                                {
                                    var result = await GitHelper.RetryRunGitCommandAsync(repo, $"fetch origin {source}", 1, null, TimeSpan.FromMinutes(2), cts.Token);
                                    if (result.IsSuccess)
                                    {
                                        fetchSuccess = true;
                                        AppendOutput($"✔ Fetch successful");
                                        successList.Add($"{repo} | {source}");
                                        break;
                                    }
                                    else
                                    {
                                        if (attempt < 3)
                                        {
                                            await Task.Delay(2000, cts.Token).ConfigureAwait(false);
                                        }
                                        else
                                        {
                                            AppendError($"❌ Fetch failed after 3 attempts: {result.StdErr}");
                                        }
                                    }
                                }
                                catch (Exception ex)
                                {
                                    if (attempt < 3)
                                    {
                                        await Task.Delay(2000, cts.Token);
                                    }
                                    else
                                    {
                                        AppendError($"❌ Fetch failed after 3 attempts: {ex.Message}");
                                    }
                                }
                            }

                            if (!fetchSuccess)
                            {
                                failList.Add($"{repo} | {source} | fetch failed");
                                continue;
                            }

                            AppendOutput($"🚀 Done: {source}\n");
                        }
                        catch (OperationCanceledException)
                        {
                            AppendError("❌ Operation cancelled");
                            failList.Add($"{repo} | {source} | cancelled");
                        }
                        catch (Exception ex)
                        {
                            AppendError($"❌ Error pulling {source}: {ex.Message}");
                            failList.Add($"{repo} | {source} | {ex.Message}");
                        }

                        AppendOutput($"✅ Completed: {System.IO.Path.GetFileName(repo)}\n");
                    }
                }

                // Generate final summary
                GenerateAndLogSummary("Pull Branches Summary", successList, skipList, failList);
            }
            catch (OperationCanceledException)
            {
                AppendError("Operation cancelled by user");
            }
            catch (Exception ex)
            {
                AppendError($"Pull failed: {ex.Message}");
            }
            finally
            {
                ButtonProgressAssist.SetIsIndeterminate(btnPullBranches, false);
                btnPullBranches.IsEnabled = true;
                cts.Dispose();
            }
        }

