        private void ChkFilterChanged(object sender, RoutedEventArgs e)
        {
            // simple filter: when checked, show errors-only marker in OutputBox by clearing non-error lines
            try
            {
                if (OutputBox == null) return;
                // persist setting
                _settings.OutputErrorsOnly = chkShowOnlyOutputErrors.IsChecked == true;
                _settings.Save();
                // re-render OutputBox from master with filter
                var text = _outputMaster.ToString();
                if (_settings.OutputErrorsOnly)
                {
                    var lines = text.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                    var filtered = string.Join(Environment.NewLine, lines.Where(l => l.Contains("❌") || l.Contains("Error") || l.Contains("FAIL") || l.Contains("fail")));
                    OutputBox.Document.Blocks.Clear();
                    OutputBox.AppendText(filtered + Environment.NewLine);
                }
                else
                {
                    OutputBox.Document.Blocks.Clear();
                    OutputBox.AppendText(text);
                }
            }
            catch { }
        }

        private void AppendOutput(string text)
        {
            var timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            var line = $"[{timestamp}] {text}\n";
            _outputQueue.Enqueue(line);
            _outputMaster.Append(line);
        }

        private void AppendError(string text)
        {
            var timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
            var line = $"[{timestamp}] {text}\n";
            _errorQueue.Enqueue(line);
            _errorMaster.Append(line);
        }

        private void FlushLogQueues()
        {
            try
            {
                // Flush output queue into inline OutputBox
                if (_outputQueue.Count > 0)
                {
                    var sb = new StringBuilder();
                    while (_outputQueue.TryDequeue(out var item))
                        sb.Append(item);

                    if (sb.Length > 0)
                    {
                        var text = sb.ToString();
                        try
                        {
                            if (OutputBox != null)
                            {
                                // update RichTextBox without destroying master
                                AppendToRichTextBox(OutputBox, text, OutputBox.Foreground);
                                // trim master
                                var max = _settings?.LogMaxChars > 0 ? _settings.LogMaxChars : MaxLogChars;
                                if (_outputMaster.Length > max)
                                    _outputMaster.Remove(0, _outputMaster.Length - max);
                            }

                            if (_streamLogsToFile && _logFileWriter != null)
                            {
                                _logFileWriter.Write(text);
                                _logFileWriter.Flush();
                            }
                        }
                        catch { }
                    }
                }

                // Flush error queue into inline ErrorBox
                if (_errorQueue.Count > 0)
                {
                    var sb2 = new StringBuilder();
                    while (_errorQueue.TryDequeue(out var item))
                        sb2.Append(item);

                    if (sb2.Length > 0)
                    {
                        var text2 = sb2.ToString();
                        try
                        {
                            if (ErrorBox != null)
                            {
                                AppendToRichTextBox(ErrorBox, text2, ErrorBox.Foreground);
                                var max = _settings?.LogMaxChars > 0 ? _settings.LogMaxChars : MaxLogChars;
                                if (_errorMaster.Length > max)
                                    _errorMaster.Remove(0, _errorMaster.Length - max);
                            }

                            if (_streamLogsToFile && _logFileWriter != null)
                            {
                                _logFileWriter.Write(text2);
                                _logFileWriter.Flush();
                            }
                        }
                        catch { }
                    }
                }
            }
            catch
            {
                // swallow logging errors
            }
        }

