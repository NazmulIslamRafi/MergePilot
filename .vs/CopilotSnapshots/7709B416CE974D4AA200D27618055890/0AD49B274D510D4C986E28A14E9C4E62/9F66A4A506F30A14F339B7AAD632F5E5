        // Navigation + highlighting helpers
        private void HighlightOutputMatch(int matchIndex)
        {
            try
            {
                if (matchIndex < 0 || matchIndex >= _outputMatchIndexes.Count) return;
                var idx = _outputMatchIndexes[matchIndex];
                var len = txtSearchOutput?.Text?.Length ?? 0;
                OutputBox.Focus();
                OutputBox.Selection.Select(OutputBox.Document.ContentStart, OutputBox.Document.ContentStart);
                var start = GetTextPointerAt(OutputBox, idx);
                var end = GetTextPointerAt(OutputBox, idx + len);
                if (start != null && end != null)
                {
                    OutputBox.Selection.Select(start, end);
                    OutputBox.ScrollToVerticalOffset(OutputBox.VerticalOffset + 0.1);
                }
            }
            catch { }
        }

        private void HighlightErrorMatch(int matchIndex)
        {
            try
            {
                if (matchIndex < 0 || matchIndex >= _errorMatchIndexes.Count) return;
                var idx = _errorMatchIndexes[matchIndex];
                var len = txtSearchError?.Text?.Length ?? 0;
                ErrorBox.Focus();
                var start = GetTextPointerAt(ErrorBox, idx);
                var end = GetTextPointerAt(ErrorBox, idx + len);
                if (start != null && end != null)
                {
                    ErrorBox.Selection.Select(start, end);
                }
            }
            catch { }
        }

        private System.Windows.Documents.TextPointer? GetTextPointerAt(System.Windows.Controls.RichTextBox box, int charIndex)
        {
            try
            {
                var navigator = box.Document.ContentStart;
                int cnt = 0;
                while (navigator != null && navigator.CompareTo(box.Document.ContentEnd) < 0)
                {
                    if (navigator.GetPointerContext(System.Windows.Documents.LogicalDirection.Forward) == System.Windows.Documents.TextPointerContext.Text)
                    {
                        string? run = navigator.GetTextInRun(System.Windows.Documents.LogicalDirection.Forward);
                        if (!string.IsNullOrEmpty(run))
                        {
                            if (cnt + run.Length >= charIndex)
                            {
                                return navigator.GetPositionAtOffset(charIndex - cnt);
                            }
                            cnt += run.Length;
                        }
                    }
                    navigator = navigator.GetNextContextPosition(System.Windows.Documents.LogicalDirection.Forward);
                }
            }
            catch { }
            return null;
        }

