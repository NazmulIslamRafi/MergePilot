        private void PopulateRepositoriesFromSettings()
        {
            try
            {
                DynamicRepoPanel.Children.Clear();
                lstRepos?.Items.Clear();
                foreach (var repo in _settings.Repositories ?? new System.Collections.Generic.List<AppSettings.RepositoryEntry>())
                {
                    var cb = new CheckBox
                    {
                        Content = repo.Name ?? repo.Path,
                        Tag = repo.Path,
                        Foreground = BrushFromHex("#CBD5E1"),
                        Margin = new System.Windows.Thickness(0, 0, 15, 0)
                    };
                    cb.Checked += CheckBox_Changed;
                    cb.Unchecked += CheckBox_Changed;
                    DynamicRepoPanel.Children.Add(cb);
                    // Add ListBoxItem with Tag set to path so selection can map back to dynamic checkbox
                    try
                    {
                        if (lstRepos != null)
                        {
                            lstRepos.Items.Add(repo);
                        }
                    }
                    catch { }
                }

                // Load recent branches into ListBoxes
                RefreshBranchLists();
            }
            catch (Exception ex)
            {
                AppendError($"PopulateRepositoriesFromSettings failed: {ex.Message}");
            }
        }

        private void RefreshBranchLists()
        {
            try
            {
                SourceBranchBox.Items.Clear();
                TargetBranchBox.Items.Clear();

                // Get selected repositories
                var selectedRepos = GetSelectedRepositories();
                if (selectedRepos.Count == 0)
                {
                    return; // No repos selected
                }

                // Collect branches from all selected repositories
                var allBranches = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                foreach (var repo in selectedRepos)
                {
                    try
                    {
                        var branches = GitHelper.GetLocalBranchesAsync(repo).Result;
                        foreach (var branch in branches)
                        {
                            allBranches.Add(branch);
                        }
                    }
                    catch (Exception ex)
                    {
                        AppendError($"Failed to load branches from {repo}: {ex.Message}");
                    }
                }

                // Add branches to ListBoxes sorted
                foreach (var branch in allBranches.OrderBy(b => b))
                {
                    SourceBranchBox.Items.Add(branch);
                    TargetBranchBox.Items.Add(branch);
                }

                ValidateSelections();
            }
            catch (Exception ex)
            {
                AppendError($"RefreshBranchLists failed: {ex.Message}");
            }
        }

        // Helper to convert hex color to brush
        private static System.Windows.Media.Brush BrushFromHex(string hex)
        {
            try
            {
                var conv = new System.Windows.Media.BrushConverter();
                return (System.Windows.Media.Brush?)conv.ConvertFromString(hex) ?? System.Windows.Media.Brushes.White;
            }
            catch
            {
                return System.Windows.Media.Brushes.White;
            }
        }

