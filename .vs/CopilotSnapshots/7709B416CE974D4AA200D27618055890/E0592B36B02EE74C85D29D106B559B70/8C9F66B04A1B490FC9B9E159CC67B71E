<Controls:MetroWindow x:Class="MergePilot.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      xmlns:Ease="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore"
                      xmlns:local="clr-namespace:MergePilot"
                      Title="Merge Pilot"
                      MinWidth="800"
                      MinHeight="600"
                      WindowStartupLocation="CenterScreen"
                      Background="#0A192F"
                      GlowBrush="#60A5FA"
                      BorderThickness="0"
                      WindowTransitionsEnabled="True"
                      Closing="MetroWindow_Closing">

    <Controls:MetroWindow.Resources>

        <Style TargetType="CheckBox" x:Key="ResponsiveCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
        </Style>
        <LinearGradientBrush x:Key="NormalGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0369A1" Offset="1"/>
        </LinearGradientBrush>

    </Controls:MetroWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <!-- Converters and responsive resources -->
    <ScrollViewer.Resources>
        <local:WidthToBoolConverter x:Key="WidthToBoolConverter" Threshold="900" />
    </ScrollViewer.Resources>
    <StackPanel Margin="14" Spacing="20">
        <!-- ============================================
             PORTION 1: REPOSITORY & BRANCH SELECTION
             ============================================ -->
        <Border CornerRadius="15" Padding="22" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                    <!-- Merge Icon -->
                    <materialDesign:PackIcon Kind="SourceMerge" 
                             Width="30" 
                             Height="30" 
                             Foreground="#60A5FA"
                             VerticalAlignment="Center"/>

                    <!-- Title -->
                    <TextBlock x:Name="TitleText" Text="Merge Pilot"
               Foreground="#60A5FA"
               FontSize="30"
               FontWeight="Bold"
               FontFamily="Segoe UI"
               VerticalAlignment="Center"
               TextDecorations="Underline"
               ToolTip="Merge Pilot - smart branch merging"
               AutomationProperties.Name="AppTitle">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="30" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Controls:MetroWindow}, Converter={StaticResource WidthToBoolConverter}}" Value="True">
                                        <Setter Property="FontSize" Value="22" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Separator Line -->
                <Border Height="1" Background="#1E293B" Margin="0,4,0,4"/>

                <!-- Target Repository Section -->
                <StackPanel Spacing="10">
                    <TextBlock Text="📁 Target Repository"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Margin="0"/>
                    
                    <StackPanel Spacing="8">
                        <!-- Manage Repos Button -->
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 0" HorizontalAlignment="Right">
                            <Button Content="⚙️  Manage Repositories" Click="ManageRepos_Click" Style="{StaticResource MaterialDesignRaisedButton}" Height="28"
                                    ToolTip="Open repository manager (Ctrl+B)" AutomationProperties.Name="ManageRepositoriesButton" />
                        </StackPanel>

                        <!-- Dynamic repository checkboxes -->
                        <StackPanel x:Name="DynamicRepoPanel" Orientation="Vertical" />

                        <!-- Repository management panel (collapsed by default) -->
                        <StackPanel x:Name="RepoManagePanel" Orientation="Vertical" Visibility="Collapsed" Margin="0 12 0 0" Background="#0F1724" Padding="12" CornerRadius="8">
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtRepoName" Grid.Column="0" MinWidth="180" Height="26" Margin="0 0 8 0" materialDesign:HintAssist.Hint="Repo friendly name" ToolTip="Friendly name for the repo" AutomationProperties.Name="RepoName" />
                                <TextBox x:Name="txtRepoPath" Grid.Column="1" Height="26" Margin="0 0 8 0" HorizontalAlignment="Stretch" materialDesign:HintAssist.Hint="Local path to repository" ToolTip="Local filesystem path to the repository" AutomationProperties.Name="RepoPath" />
                                <Button x:Name="btnBrowseRepoPath" Grid.Column="2" Content="..." Width="28" Height="26" Margin="0 0 8 0" Click="BrowseRepoPath_Click" />
                                <Button x:Name="btnAddRepo" Grid.Column="3" Content="Add Repo" Width="90" Height="26" Click="AddRepo_Click" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <ListView x:Name="lstRepos" MinWidth="200" Height="120" HorizontalAlignment="Stretch" SelectionChanged="LstRepos_SelectionChanged"
                                          ToolTip="List of configured repositories" AutomationProperties.Name="RepositoriesList" KeyboardNavigation.TabIndex="5">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Path" Width="480" DisplayMemberBinding="{Binding Path}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 8 0 0" Spacing="8">
                                <Button x:Name="btnEditRepo" Content="Edit Selected" Width="100" Height="26" Click="EditRepo_Click" ToolTip="Edit selected repo" AutomationProperties.Name="EditRepoButton" />
                                <Button x:Name="btnUpdateRepo" Content="Update" Width="80" Height="26" Click="UpdateRepo_Click" IsEnabled="False" ToolTip="Update selected repo" AutomationProperties.Name="UpdateRepoButton" />
                                <Button x:Name="btnRemoveRepo" Content="Remove Selected" Width="120" Height="26" Click="RemoveRepo_Click" ToolTip="Remove selected repo" AutomationProperties.Name="RemoveRepoButton" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Separator Line -->
                <Border Height="1" Background="#1E293B" Margin="0,4,0,4"/>

                <!-- Branches Section -->
                <StackPanel Spacing="10">
                    <TextBlock Text="🌿 Branch Configuration"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Margin="0"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Source Branch :"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="0 0 12 0"/>
                        <ComboBox Grid.Column="1" x:Name="SourceBranchBox"
                                  Style="{StaticResource ResponsiveComboBoxStyle}"
                                  MinWidth="150"
                                  IsEditable="True"
                                  HorizontalAlignment="Stretch"
                                  materialDesign:HintAssist.Hint="Source branch (or type)" />

                        <TextBlock Grid.Column="3" Text="Target Branch :"
                                   Foreground="#CBD5E1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="0 0 12 0"/>
                        <ComboBox Grid.Column="4" x:Name="TargetBranchBox"
                                  Style="{StaticResource ResponsiveComboBoxStyle}"
                                  MinWidth="150"
                                  IsEditable="True"
                                  HorizontalAlignment="Stretch"
                                  materialDesign:HintAssist.Hint="Target branch (or type)" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================================
             PORTION 2: ACTION BUTTONS
             ============================================ -->
        <Border CornerRadius="15" Padding="20" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}">
            <StackPanel Spacing="12">
                <TextBlock Text="⚡ Actions"
                           Foreground="#CBD5E1"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           Margin="0"/>
                
                <!-- Separator Line -->
                <Border Height="1" Background="#1E293B" Margin="0,4,0,4"/>

                <!-- Buttons Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Merge Button -->
                    <Button x:Name="btnMerge"
                            Grid.Column="0"
                            Content="MERGE BRANCHES"
                            IsEnabled="False"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource NormalGradientBrush}"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="50"
                            Padding="20 10"
                            Click="Merge_Click"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon x:Name="RocketIcon" Kind="RocketLaunch" Foreground="#FB923C" Width="20" Height="20" Margin="0 0 8 0">
                                            <materialDesign:PackIcon.RenderTransform>
                                                <TranslateTransform Y="0"/>
                                            </materialDesign:PackIcon.RenderTransform>
                                        </materialDesign:PackIcon>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource HoverGradientBrush}"/>
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource NormalGradientBrush}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="RocketAnimStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="RocketIcon"
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                        From="0" To="-6"
                                                        Duration="0:0:0.6"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                        </Trigger.ExitActions>
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#475569"/>
                                        <Setter Property="Opacity" Value="0.7"/>
                                        <Trigger.EnterActions>
                                            <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Pull Button -->
                    <Button x:Name="btnPullBranches"
                            Grid.Column="2"
                            Content="PULL BRANCHES"
                            ToolTip="Fetch latest branches from origin for selected repositories"
                            Click="PullSelectedBranches_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource NormalGradientBrush}"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="50"
                            Padding="20 10"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="False" />

                    <!-- Refresh Button -->
                    <Button x:Name="btnRefreshBranches"
                            Grid.Column="4"
                            Content="REFRESH BRANCHES"
                            ToolTip="Refresh remote branch list for selected repositories"
                            Click="RefreshBranches_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource NormalGradientBrush}"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="50"
                            Padding="20 10"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="False" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================
             PORTION 3: LOGS & OUTPUT
             ============================================ -->
        <Border x:Name="LogBorder" CornerRadius="15" Padding="16" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}">
            <StackPanel Spacing="12">
                <!-- Header with Controls -->
                <StackPanel Spacing="10">
                    <TextBlock Text="📋 Logs & Output"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Margin="0"/>
                    
                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0"/>

                    <!-- Log Controls Toolbar -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="32" ItemWidth="Auto" Spacing="8">
                        <Button Content="Show Logs" Width="100" Height="28" Click="ToggleLogs_Click" ToolTip="Show or hide inline logs (Ctrl+L)"/>

                        <Button x:Name="btnSaveLogs" Content="Save" Width="70" Height="28" Click="SaveLogs_Click" ToolTip="Save logs to file" />
                        <Button x:Name="btnClearLogs" Content="Clear" Width="70" Height="28" Click="ClearErrorBox_Click" ToolTip="Clear both output and error logs" />
                        <Button x:Name="btnCopyLogs" Content="Copy" Width="70" Height="28" Click="CopyLogs_Click" ToolTip="Copy combined logs to clipboard" />

                        <Separator Width="1" Background="#475569" VerticalAlignment="Stretch" Margin="4 0"/>

                        <CheckBox x:Name="chkAutoOpen" Content="Auto-open logs" VerticalAlignment="Center" Checked="chkAutoOpen_Checked" Unchecked="chkAutoOpen_Unchecked"/>

                        <CheckBox x:Name="chkStreamLogs" Content="Stream Logs" VerticalAlignment="Center" Checked="chkStreamLogs_Checked" Unchecked="chkStreamLogs_Unchecked"/>
                        
                        <TextBox x:Name="txtLogPath" Width="200" Height="26" IsReadOnly="True" VerticalAlignment="Center" materialDesign:HintAssist.Hint="Log file path"/>
                        <Button Content="…" Width="28" Height="26" Click="SelectLogPath_Click" ToolTip="Select log path"/>

                        <!-- Streaming indicator -->
                        <Ellipse x:Name="ellipseStreamIndicator" Width="12" Height="12" Fill="#475569" Stroke="#111" StrokeThickness="1" VerticalAlignment="Center" ToolTip="Streaming disabled" />

                        <!-- Flush interval slider -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="Flush (ms):" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            <Slider x:Name="sldFlushInterval" Minimum="100" Maximum="1000" Width="120" ValueChanged="sldFlushInterval_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtFlushValue" Foreground="#CBD5E1" VerticalAlignment="Center" Width="40"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- Separator Line -->
                <Border Height="1" Background="#1E293B" Margin="0"/>

                <!-- Logs Content -->
                <Grid Height="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Output Log Section -->
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Output Log" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold" Margin="0"/>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <TextBox x:Name="txtSearchOutput" Width="140" Height="24" materialDesign:HintAssist.Hint="Search output" />
                                <Button Content="Find" Width="50" Height="24" />
                                <Button Content="◀" Width="28" Height="24" Click="PrevOutputMatch_Click" ToolTip="Previous match" />
                                <Button Content="▶" Width="28" Height="24" Click="NextOutputMatch_Click" ToolTip="Next match" />
                                <CheckBox x:Name="chkShowOnlyOutputErrors" Content="Errors only" Margin="8 0 0 0" Checked="ChkFilterChanged" Unchecked="ChkFilterChanged" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0F1724" Padding="8" CornerRadius="6">
                                <RichTextBox x:Name="OutputBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0F1724" Foreground="#E2E8F0" BorderThickness="0" VerticalScrollBarVisibility="Auto" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="Transparent" />

                    <!-- Error Log Section -->
                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="Error Log" Foreground="#F87171" FontSize="12" FontWeight="SemiBold" Margin="0"/>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <TextBox x:Name="txtSearchError" Width="140" Height="24" materialDesign:HintAssist.Hint="Search errors" />
                                <Button Content="Find" Width="50" Height="24"  />
                                <Button Content="◀" Width="28" Height="24" Click="PrevErrorMatch_Click" ToolTip="Previous match" />
                                <Button Content="▶" Width="28" Height="24" Click="NextErrorMatch_Click" ToolTip="Next match" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0F1724" Padding="8" CornerRadius="6">
                                <RichTextBox x:Name="ErrorBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0F1724" Foreground="#FCA5A5" BorderThickness="0" VerticalScrollBarVisibility="Auto" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================
             FOOTER
             ============================================ -->
        <TextBlock Text="Developed by Md Nazmul Islam"
                   Foreground="#64748B"
                   FontSize="12"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Right"
                   Margin="0 10 0 10"/>
    </StackPanel>
    </ScrollViewer>
</Controls:MetroWindow>