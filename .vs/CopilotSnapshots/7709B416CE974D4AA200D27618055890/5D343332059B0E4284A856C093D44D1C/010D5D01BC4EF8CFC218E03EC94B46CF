<Controls:MetroWindow x:Class="MergePilot.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      xmlns:Ease="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore"
                      xmlns:local="clr-namespace:MergePilot"
                      Title="Merge Pilot"
                      MinWidth="800"
                      MinHeight="600"
                      WindowStartupLocation="CenterScreen"
                      Background="#0A192F"
                      GlowBrush="#60A5FA"
                      BorderThickness="0"
                      WindowTransitionsEnabled="True"
                      Closing="MetroWindow_Closing">

    <Controls:MetroWindow.Resources>

        <Style TargetType="CheckBox" x:Key="ResponsiveCheckBoxStyle">
            <Setter Property="Margin" Value="0 0 15 0"/>
        </Style>
        <LinearGradientBrush x:Key="NormalGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0369A1" Offset="1"/>
        </LinearGradientBrush>

    </Controls:MetroWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <!-- Converters and responsive resources -->
        <ScrollViewer.Resources>
            <local:WidthToBoolConverter x:Key="WidthToBoolConverter" Threshold="900" />
        </ScrollViewer.Resources>
        
        <StackPanel Margin="14">
        
            <!-- ============================================
                 PORTION 1: REPOSITORY & BRANCH SELECTION
                 ============================================ -->
            <Border CornerRadius="15" Padding="22" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Margin="0 0 0 20">
                <StackPanel>
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                        <!-- Merge Icon -->
                        <materialDesign:PackIcon Kind="SourceMerge" 
                                 Width="30" 
                                 Height="30" 
                                 Foreground="#60A5FA"
                                 VerticalAlignment="Center"/>

                        <!-- Title -->
                        <TextBlock x:Name="TitleText" Text="Merge Pilot"
               Foreground="#60A5FA"
               FontSize="30"
               FontWeight="Bold"
               FontFamily="Segoe UI"
               VerticalAlignment="Center"
               TextDecorations="Underline"
               ToolTip="Merge Pilot - smart branch merging"
               AutomationProperties.Name="AppTitle"
               Margin="8 0 0 0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="30" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Controls:MetroWindow}, Converter={StaticResource WidthToBoolConverter}}" Value="True">
                                            <Setter Property="FontSize" Value="22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0,4,0,12"/>

                    <!-- Target Repository Section -->
                    <StackPanel Margin="0 0 0 12">
                        <TextBlock Text="📁 Target Repository"
                                   Foreground="#CBD5E1"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 10"/>
                        
                        <StackPanel Margin="0">
                            <!-- Manage Repos Button -->
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 8" HorizontalAlignment="Right">
                                <Button Content="⚙️  Manage Repositories" Click="ManageRepos_Click" Style="{StaticResource MaterialDesignRaisedButton}" Height="28"
                                        ToolTip="Open repository manager (Ctrl+B)" AutomationProperties.Name="ManageRepositoriesButton" />
                            </StackPanel>

                            <!-- Dynamic repository checkboxes -->
                            <StackPanel x:Name="DynamicRepoPanel" Orientation="Vertical" Margin="0 0 0 8"/>

                            <!-- Repository management panel (collapsed by default) -->
                            <StackPanel x:Name="RepoManagePanel" Orientation="Vertical" Visibility="Collapsed" Margin="0 12 0 0" Background="#0F1724">
                                <Grid Margin="12 12 12 8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtRepoName" Grid.Column="0" MinWidth="180" Height="26" Margin="0 0 8 0" materialDesign:HintAssist.Hint="Repo friendly name" ToolTip="Friendly name for the repo" AutomationProperties.Name="RepoName" />
                                    <TextBox x:Name="txtRepoPath" Grid.Column="1" Height="26" Margin="0 0 8 0" HorizontalAlignment="Stretch" materialDesign:HintAssist.Hint="Local path to repository" ToolTip="Local filesystem path to the repository" AutomationProperties.Name="RepoPath" />
                                    <Button x:Name="btnBrowseRepoPath" Grid.Column="2" Content="..." Width="28" Height="26" Margin="0 0 8 0" Click="BrowseRepoPath_Click" />
                                    <Button x:Name="btnAddRepo" Grid.Column="3" Content="Add Repo" Width="90" Height="26" Click="AddRepo_Click" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="12 4 12 0">
                                    <ListView x:Name="lstRepos" MinWidth="200" Height="120" HorizontalAlignment="Stretch" SelectionChanged="LstRepos_SelectionChanged"
                                              ToolTip="List of configured repositories" AutomationProperties.Name="RepositoriesList" KeyboardNavigation.TabIndex="5">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Path" Width="480" DisplayMemberBinding="{Binding Path}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="12 8 12 12">
                                    <Button x:Name="btnEditRepo" Content="Edit Selected" Width="100" Height="26" Click="EditRepo_Click" Margin="0 0 8 0" ToolTip="Edit selected repo" AutomationProperties.Name="EditRepoButton" />
                                    <Button x:Name="btnUpdateRepo" Content="Update" Width="80" Height="26" Click="UpdateRepo_Click" IsEnabled="False" Margin="0 0 8 0" ToolTip="Update selected repo" AutomationProperties.Name="UpdateRepoButton" />
                                    <Button x:Name="btnRemoveRepo" Content="Remove Selected" Width="120" Height="26" Click="RemoveRepo_Click" ToolTip="Remove selected repo" AutomationProperties.Name="RemoveRepoButton" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0,4,0,12"/>

                    <!-- Branches Section -->
                    <StackPanel Margin="0">
                        <TextBlock Text="🌿 Branch Configuration"
                                   Foreground="#CBD5E1"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Margin="0 0 0 10"/>
                        
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Source Branch Section -->
                            <StackPanel Grid.Column="0" Margin="0">
                                <TextBlock Text="Source Branch (Select One)"
                                           Foreground="#A0AEC0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6"/>
                                <ListBox x:Name="SourceBranchBox"
                                         Background="#0F1724"
                                         Foreground="#E2E8F0"
                                         BorderBrush="#334155"
                                         Height="140"
                                         SelectionMode="Single"
                                         ToolTip="Select source branch (only one allowed)"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Rectangle Grid.Column="1" Fill="Transparent" />

                            <!-- Target Branch Section -->
                            <StackPanel Grid.Column="2" Margin="0">
                                <TextBlock Text="Target Branches (Select Multiple)"
                                           Foreground="#A0AEC0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           FontFamily="Segoe UI"
                                           Margin="0 0 0 6"/>
                                <ListBox x:Name="TargetBranchBox"
                                         Background="#0F1724"
                                         Foreground="#E2E8F0"
                                         BorderBrush="#334155"
                                         Height="140"
                                         SelectionMode="Multiple"
                                         ToolTip="Select target branches (multiple allowed)"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================
                 PORTION 2: ACTION BUTTONS
                 ============================================ -->
            <Border CornerRadius="15" Padding="20" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="⚡ Actions"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Margin="0 0 0 12"/>
                    
                    <!-- Separator Line -->
                    <Border Height="1" Background="#1E293B" Margin="0 0 0 12"/>

                    <!-- Buttons Grid -->
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Merge Button -->
                        <Button x:Name="btnMerge"
                                Grid.Column="0"
                                Content="MERGE BRANCHES"
                                IsEnabled="False"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource NormalGradientBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="50"
                                Padding="20 10"
                                Click="Merge_Click"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon x:Name="RocketIcon" Kind="RocketLaunch" Foreground="#FB923C" Width="20" Height="20" Margin="0 0 8 0">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <TranslateTransform Y="0"/>
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource HoverGradientBrush}"/>
                                        </Trigger>

                                        <Trigger Property="IsEnabled" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource NormalGradientBrush}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard x:Name="RocketAnimStoryboard">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="RocketIcon"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            From="0" To="-6"
                                                            Duration="0:0:0.6"
                                                            AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                            </Trigger.ExitActions>
                                        </Trigger>

                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#475569"/>
                                            <Setter Property="Opacity" Value="0.7"/>
                                            <Trigger.EnterActions>
                                                <StopStoryboard BeginStoryboardName="RocketAnimStoryboard"/>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Pull Button -->
                        <Button x:Name="btnPullBranches"
                                Grid.Column="2"
                                Content="PULL BRANCHES"
                                ToolTip="Fetch latest branches from origin for selected repositories"
                                Click="PullSelectedBranches_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource NormalGradientBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="50"
                                Padding="20 10"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="False" />

                        <!-- Refresh Button -->
                        <Button x:Name="btnRefreshBranches"
                                Grid.Column="4"
                                Content="REFRESH BRANCHES"
                                ToolTip="Refresh remote branch list for selected repositories"
                                Click="RefreshBranches_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource NormalGradientBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="50"
                                Padding="20 10"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================
                 PORTION 3: LOGS & OUTPUT
                 ============================================ -->
            <Border CornerRadius="15" Padding="16" Background="#142033" Effect="{DynamicResource MaterialDesignElevation6}" Margin="0 0 0 20">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Margin="0 0 0 12">
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="📋 Merge Log"
                                       Foreground="#CBD5E1"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Margin="0" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnClearLogs" Content="Clear" Width="70" Height="28" Margin="0 0 8 0" Click="ClearErrorBox_Click" ToolTip="Clear logs" />
                                <Button x:Name="btnCopyLogs" Content="Copy" Width="70" Height="28" Margin="0 0 8 0" Click="CopyLogs_Click" ToolTip="Copy logs to clipboard" />
                                <Button x:Name="btnSaveLogs" Content="Save" Width="70" Height="28" Click="SaveLogs_Click" ToolTip="Save logs to file" />
                            </StackPanel>
                        </Grid>
                        
                        <!-- Separator Line -->
                        <Border Height="1" Background="#1E293B" Margin="0"/>
                    </StackPanel>

                    <!-- Single Log Display -->
                    <Border Background="#0F1724" CornerRadius="6" Padding="8" Height="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <RichTextBox x:Name="OutputBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0F1724" Foreground="#E2E8F0" BorderThickness="0" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================
                 FOOTER
                 ============================================ -->
            <TextBlock Text="Developed by Md Nazmul Islam"
                       Foreground="#64748B"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Right"
                       Margin="0 10 0 10"/>
    </StackPanel>
    </ScrollViewer>
</Controls:MetroWindow>