        private void OpenOutputWindow()
        {
            try
            {
                if (_outputLogWindow == null)
                    _outputLogWindow = new LogWindow() { Owner = this, Title = "Output Log" };

                _outputLogWindow.Show();
                _outputLogWindow.Activate();
            }
            catch { }
        }

        private void OpenErrorWindow()
