        }

        // Toggle streaming to files
        private void StartStreamOutput(string path)
        {
            try
            {
                _outputFileWriter?.Dispose();
                _outputFileWriter = new StreamWriter(new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
                _streamOutputToFile = true;
            }
            catch { }
        }

        private void StopStreamOutput()
        {
            try
            {
                _outputFileWriter?.Flush();
                _outputFileWriter?.Dispose();
                _outputFileWriter = null;
                _streamOutputToFile = false;
            }
            catch { }
        }

        private void StartStreamError(string path)
        {
            try
            {
                _errorFileWriter?.Dispose();
                _errorFileWriter = new StreamWriter(new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.Read)) { AutoFlush = true };
                _streamErrorToFile = true;
            }
            catch { }
        }

        private void StopStreamError()
        {
            try
            {
                _errorFileWriter?.Flush();
                _errorFileWriter?.Dispose();
                _errorFileWriter = null;
                _streamErrorToFile = false;
            }
            catch { }
        }
