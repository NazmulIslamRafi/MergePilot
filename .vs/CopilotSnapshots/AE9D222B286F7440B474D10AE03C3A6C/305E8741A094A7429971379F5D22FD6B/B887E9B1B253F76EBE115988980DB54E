        private void SelectOutputPath()
        {
            var dlg = new Microsoft.Win32.SaveFileDialog()
            {
                Filter = "Text Files (*.txt)|*.txt|All Files (*.*)|*.*",
                DefaultExt = "txt",
                FileName = "output.log"
            };

            if (dlg.ShowDialog(this) == true)
            {
                txtOutputPath.Text = dlg.FileName;
            }
        }

        private void SelectErrorPath()
        {
            var dlg = new Microsoft.Win32.SaveFileDialog()
